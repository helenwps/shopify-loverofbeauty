{% comment %}
  Section: GMK Lulus Header（移动端禁用吸顶，品牌区和公告栏正常滚动）
{% endcomment %}

{% liquid
  assign section_id = 'gmk-lulus-header-' | append: section.id
  assign enable_section = section.settings.enable_section
  assign active_brand_key = section.settings.default_brand_key | strip
  assign section_width = section.settings.section_width
  assign content_max_width = section.settings.content_max_width
  assign top_row_height = section.settings.top_row_height
  assign nav_height = section.settings.nav_height
  assign dropdown_max_height = section.settings.dropdown_max_height
  assign collapse_offset = section.settings.collapse_offset
  assign sticky_header = section.settings.sticky_header
  assign collapse_on_scroll = section.settings.collapse_on_scroll
  assign search_placeholder = section.settings.search_placeholder | strip
  assign market_label = section.settings.market_label | strip
  assign account_link = section.settings.account_link
  assign wishlist_link = section.settings.wishlist_link
  assign cart_link = section.settings.cart_link
  assign background_color = section.settings.background_color
  assign nav_background_color = section.settings.nav_background_color
  assign inactive_brand_color = section.settings.inactive_brand_color
  assign text_color = section.settings.text_color
  assign muted_color = section.settings.muted_color
  assign border_color = section.settings.border_color
  assign accent_color = section.settings.accent_color
  assign market_background_color = section.settings.market_background_color
  assign market_text_color = section.settings.market_text_color
  assign render_header = false

  if account_link == blank
    assign account_link = routes.account_login_url
  endif

  if cart_link == blank
    assign cart_link = routes.cart_url
  endif

  case section_width
    when 'full'
      assign container_width = '100%'
    when 'wide'
      assign container_width = content_max_width | append: 'px'
    when 'standard'
      assign container_width = '1440px'
    when 'narrow'
      assign container_width = '1180px'
    else
      assign container_width = content_max_width | append: 'px'
  endcase

  for header_block in section.blocks
    if header_block.type == 'brand' or header_block.type == 'nav_item'
      assign render_header = true
    endif
  endfor
%}

{% if enable_section and render_header %}
  <style>
    /* ========== 基础变量 ========== */
    #{{ section_id }} {
      --gmk-lulus-header-container: {{ container_width }};
      --gmk-lulus-header-top-height: {{ top_row_height }}px;
      --gmk-lulus-header-nav-height: {{ nav_height }}px;
      --gmk-lulus-header-dropdown-max-height: {{ dropdown_max_height }}px;
      --gmk-lulus-header-bg: {{ background_color }};
      --gmk-lulus-header-nav-bg: {{ nav_background_color }};
      --gmk-lulus-header-inactive-brand: {{ inactive_brand_color }};
      --gmk-lulus-header-text: {{ text_color }};
      --gmk-lulus-header-muted: {{ muted_color }};
      --gmk-lulus-header-border: {{ border_color }};
      --gmk-lulus-header-accent: {{ accent_color }};
      --gmk-lulus-header-market-bg: {{ market_background_color }};
      --gmk-lulus-header-market-text: {{ market_text_color }};
      color: var(--gmk-lulus-header-text);
      background: var(--gmk-lulus-header-bg);
      font-family: Arial, Helvetica, sans-serif;
      letter-spacing: 0;
      z-index: 40;
    }

    #{{ section_id }}.gmk-lulus-header--sticky {
      position: sticky;
      top: 0;
    }

    #{{ section_id }} * {
      box-sizing: border-box;
    }

    #{{ section_id }} a {
      color: inherit;
      text-decoration: none;
    }

    /* ========== 顶部区域 ========== */
    #{{ section_id }} .gmk-lulus-header__shell {
      position: relative;
      width: 100%;
      background: var(--gmk-lulus-header-bg);
      box-shadow: 0 1px 0 var(--gmk-lulus-header-border);
    }

    #{{ section_id }} .gmk-lulus-header__top,
    #{{ section_id }} .gmk-lulus-header__nav-inner,
    #{{ section_id }} .gmk-lulus-header__mega-inner {
      width: min(100%, var(--gmk-lulus-header-container));
      margin: 0 auto;
    }

    #{{ section_id }} .gmk-lulus-header__top {
      display: flex;
      align-items: stretch;
      justify-content: space-between;
      min-height: var(--gmk-lulus-header-top-height);
      overflow: hidden;
      transition: min-height 180ms ease, max-height 180ms ease, opacity 160ms ease;
    }

    #{{ section_id }}.is-condensed .gmk-lulus-header__top {
      max-height: 0;
      min-height: 0;
      opacity: 0;
      pointer-events: none;
    }

    /* ========== 品牌区 ========== */
    #{{ section_id }} .gmk-lulus-header__brands {
      display: flex;
      align-items: stretch;
      min-width: min(48vw, 480px);
      overflow-x: auto;
      scrollbar-width: none;
    }

    #{{ section_id }} .gmk-lulus-header__brands::-webkit-scrollbar {
      display: none;
    }

    #{{ section_id }} .gmk-lulus-header__brand-button {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 250px;
      height: var(--gmk-lulus-header-top-height);
      padding: 14px 28px;
      border: 0;
      border-right: 1px solid var(--gmk-lulus-header-border);
      background: var(--gmk-lulus-header-inactive-brand);
      color: var(--gmk-lulus-header-text);
      cursor: pointer;
      transition: background 160ms ease, opacity 160ms ease;
    }

    #{{ section_id }} .gmk-lulus-header__brand-button.is-active {
      background: var(--gmk-lulus-header-bg);
    }

    #{{ section_id }} .gmk-lulus-header__brand-image {
      display: block;
      width: auto;
      max-width: 190px;
      max-height: 56px;
      object-fit: contain;
    }

    #{{ section_id }} .gmk-lulus-header__brand-text {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--gmk-lulus-header-text);
      line-height: 1;
      white-space: nowrap;
    }

    #{{ section_id }} .gmk-lulus-header__brand-text--script {
      font-family: "Brush Script MT", "Segoe Script", cursive;
      font-size: 40px;
      font-weight: 400;
    }

    #{{ section_id }} .gmk-lulus-header__brand-text--serif {
      gap: 7px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 26px;
      font-weight: 400;
      text-transform: none;
    }

    #{{ section_id }} .gmk-lulus-header__brand-outlet-the {
      display: inline-block;
      font-size: 22px;
      line-height: 1;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    #{{ section_id }} .gmk-lulus-header__brand-outlet-main {
      display: inline-block;
      text-transform: uppercase;
    }

    /* ========== 右侧工具区 ========== */
    #{{ section_id }} .gmk-lulus-header__tools {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 24px;
      flex: 1 1 auto;
      min-width: 0;
      padding: 0 44px 0 28px;
      background: var(--gmk-lulus-header-inactive-brand);
    }

    #{{ section_id }} .gmk-lulus-header__search {
      display: flex;
      align-items: center;
      flex: 0 1 230px;
      min-width: 220px;
      border-bottom: 1px solid currentColor;
      color: var(--gmk-lulus-header-text);
    }

    #{{ section_id }} .gmk-lulus-header__search-input {
      width: 100%;
      min-width: 0;
      height: 34px;
      padding: 0 8px 0 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--gmk-lulus-header-text);
      font-size: 14px;
    }

    #{{ section_id }} .gmk-lulus-header__search-input::placeholder {
      color: var(--gmk-lulus-header-text);
      opacity: 0.92;
    }

    #{{ section_id }} .gmk-lulus-header__icon-button {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--gmk-lulus-header-text);
      cursor: pointer;
    }
 
    #{{ section_id }} .gmk-lulus-header__icon-button svg {
      display: block;
      width: 24px;
      height: 24px;
      stroke-width: 1.2;
    }

    #{{ section_id }} .gmk-lulus-header__market {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 30px;
      border: 0;
      background: var(--gmk-lulus-header-market-bg);
      color: var(--gmk-lulus-header-market-text);
      font-size: 13px;
      font-weight: 700;
      line-height: 1;
    }

    #{{ section_id }} .gmk-lulus-header__cart-count {
      position: absolute;
      right: 0px;
      bottom: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 15px;
      height: 15px;
      border-radius: 999px;
      background: #202020;
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      line-height: 1;
    }

    /* ========== 桌面导航栏 ========== */
    #{{ section_id }} .gmk-lulus-header__nav-shell {
      position: relative;
      min-height: var(--gmk-lulus-header-nav-height);
      background: var(--gmk-lulus-header-nav-bg);
      border-top: 1px solid var(--gmk-lulus-header-border);
    }

    #{{ section_id }} .gmk-lulus-header__nav-inner {
      min-height: var(--gmk-lulus-header-nav-height);
    }

    #{{ section_id }} .gmk-lulus-header__nav-list {
      display: flex;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      min-height: var(--gmk-lulus-header-nav-height);
      margin: 0;
      padding: 0 42px;
      list-style: none;
      overflow-x: auto;
      overflow-y: visible;
      scrollbar-width: none;
    }

    #{{ section_id }} .gmk-lulus-header__nav-list::-webkit-scrollbar {
      display: none;
    }

    #{{ section_id }} .gmk-lulus-header__nav-list[hidden] {
      display: none;
    }

    #{{ section_id }} .gmk-lulus-header__nav-item {
      position: static;
      display: flex;
      align-items: stretch;
      flex: 0 0 auto;
    }

    #{{ section_id }} .gmk-lulus-header__nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: var(--gmk-lulus-header-nav-height);
      padding: 0 18px;
      border: 0;
      background: transparent;
      color: var(--gmk-lulus-header-text);
      font-size: 14px;
      font-weight: 400;
      line-height: 1.2;
      white-space: nowrap;
      cursor: pointer;
    }

    #{{ section_id }} .gmk-lulus-header__nav-link::after {
      position: absolute;
      right: 18px;
      bottom: 0;
      left: 50%;
      margin-left: -15px;
      width: 30px;
      height: 3px;
      background: var(--gmk-lulus-header-accent);
      content: "";
      opacity: 0;
      transform: scaleX(0.5);
      transition: opacity 140ms ease, transform 140ms ease;
    }

    #{{ section_id }} .gmk-lulus-header__nav-item:hover > .gmk-lulus-header__nav-link::after,
    #{{ section_id }} .gmk-lulus-header__nav-item:focus-within > .gmk-lulus-header__nav-link::after,
    #{{ section_id }} .gmk-lulus-header__nav-item.is-open > .gmk-lulus-header__nav-link::after {
      opacity: 1;
      transform: scaleX(1);
    }

    /* ========== 桌面 Mega 菜单 ========== */
    #{{ section_id }} .gmk-lulus-header__mega {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 5;
      display: none;
      max-height: var(--gmk-lulus-header-dropdown-max-height);
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--gmk-lulus-header-bg);
      transition: all 0s ease-out .2s;
      border-top: 1px solid var(--gmk-lulus-header-border);
      box-shadow: 0 1px 0 var(--gmk-lulus-header-border);
    }

    #{{ section_id }} .gmk-lulus-header__nav-item.is-open > .gmk-lulus-header__mega {
      display: block;
      transition: all 0s linear 0.2s;
    }

    @media (hover: hover) and (pointer: fine) {
      #{{ section_id }} .gmk-lulus-header__nav-item.has-mega:hover > .gmk-lulus-header__mega,
      #{{ section_id }} .gmk-lulus-header__nav-item.has-mega:focus-within > .gmk-lulus-header__mega {
        display: block;
        transition: all 0s linear 0.2s;
      }
    }

    #{{ section_id }} .gmk-lulus-header__mega-inner {
      display: flex;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 54px;
      min-height: 470px;
      padding: 44px 72px 56px;
    }

    #{{ section_id }} .gmk-lulus-header__mega-columns {
      display: flex;
      align-items: flex-start;
      gap: 58px;
      flex: 0 1 auto;
    }

    #{{ section_id }} .gmk-lulus-header__mega-column {
      flex: 0 0 190px;
      min-width: 160px;
      color: var(--gmk-lulus-header-text);
    }

    #{{ section_id }} .gmk-lulus-header__mega-column--wide {
      flex-basis: 235px;
    }

    #{{ section_id }} .gmk-lulus-header__mega-title,
    #{{ section_id }} .gmk-lulus-header__mega-subtitle {
      margin: 0 0 18px;
      color: var(--gmk-lulus-header-text);
      font-size: 14px;
      font-weight: 600;
      line-height: 1.25;
    }

    #{{ section_id }} .gmk-lulus-header__mega-subtitle {
      margin-top: 30px;
    }

    #{{ section_id }} .gmk-lulus-header__mega-links {
      display: grid;
      gap: 16px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #{{ section_id }} .gmk-lulus-header__promos {
      display: flex;
      align-items: flex-start;
      gap: 34px;
      flex: 0 0 auto;
    }

    #{{ section_id }} .gmk-lulus-header__promo {
      width: 304px;
      text-align: center;
    }

    #{{ section_id }} .gmk-lulus-header__promo-link {
      display: block;
    }

    #{{ section_id }} .gmk-lulus-header__promo-media {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: #f4f4f4;
    }

    #{{ section_id }} .gmk-lulus-header__promo-media--portrait {
      aspect-ratio: 3 / 4;
    }

    #{{ section_id }} .gmk-lulus-header__promo-media--square {
      aspect-ratio: 1 / 1;
    }

    #{{ section_id }} .gmk-lulus-header__promo-media--tall {
      aspect-ratio: 5 / 7;
    }

    #{{ section_id }} .gmk-lulus-header__promo-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #{{ section_id }} .gmk-lulus-header__promo-title {
      margin: 18px 0 0;
      color: var(--gmk-lulus-header-text);
      font-size: 14px;
      font-weight: 600;
      line-height: 1.25;
    }

    #{{ section_id }} .gmk-lulus-header__mega-link,
    #{{ section_id }} .gmk-lulus-header__mega-label {
      display: inline-block;
      color: var(--gmk-lulus-header-muted);
      font-size: 14px;
      line-height: 1.28;
    }

    #{{ section_id }} .gmk-lulus-header__mega-link:hover {
      color: var(--gmk-lulus-header-text);
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    #{{ section_id }} .gmk-lulus-header__brand-button-logo {
      display: none;
    }

    /* ========== 移动端样式 ========== */
    #{{ section_id }} .gmk-lulus-header__menu-toggle {
      display: none;
    }

    #{{ section_id }} .gmk-lulus-header__nav-inner {
      min-height: auto;
    }

    /* 抽屉：左侧滑出，动态 top */
    #{{ section_id }} .gmk-lulus-header__mobile-drawer {
      position: fixed;
      left: 0;
      right: auto;
      bottom: 0;
      z-index: 1000;
      width: 85%;
      max-width: 380px;
      background: var(--gmk-lulus-header-bg);
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      visibility: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    #{{ section_id }} .gmk-lulus-header__mobile-drawer.is-open {
      transform: translateX(0);
      visibility: visible;
    }

    /* 遮罩层：默认全屏，打开抽屉时动态设置 top 为 header 高度，避免覆盖工具栏 */
    #{{ section_id }} .gmk-lulus-header__drawer-overlay {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 999;
      background: rgba(0, 0, 0, 0.5);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    #{{ section_id }} .gmk-lulus-header__drawer-overlay.is-active {
      opacity: 1;
      visibility: visible;
    }

    /* 移动端导航容器内样式 */
    .c-site-nav-mobile__list {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .c-site-nav-mobile__list .o-list-plain {
      display: flex;
      flex-flow: column;
      gap: 2px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    @media screen and (max-width: 989px) {
      .c-site-nav-mobile__list .o-list-plain {
        background: #fff;
      }
      .c-submenu .o-list-plain li,
      .o-list-plain li {
        background: #fcfcfc;
      }
    }

    .c-menu {
      flex: 1;
    }

    .c-menu__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 20px;
      font-size: 18px;
      font-weight: 500;
      color: var(--gmk-lulus-header-text);
      border: 0;
      width: 100%;
      cursor: pointer;
      text-align: left;
      text-decoration: none;
    }

    .c-menu__link--icon {
      justify-content: space-between;
      gap: 12px;
    }
    .c-menu__link--icon .o-flex-col {
      display: inline-flex;
      gap: 12px;
    }
    .c-menu__acct {
      background: var(--gmk-lulus-header-inactive-brand);
    }

    .c-menu__acct-list {
      display: none;
      background: var(--gmk-lulus-header-bg);
    }

    .c-menu__acct-list .c-menu__link {
      padding-left: 56px;
      font-weight: normal;
      border-bottom: none;
    }

    .c-submenu {
      display: none;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--gmk-lulus-header-bg);
      overflow-y: auto;
      z-index: 10;
    }

    .c-submenu.is-active {
      display: block;
    }

    .c-submenu__btn {
      background: none;
      border: 0;
      font-size: 24px;
      cursor: pointer;
      padding-right: 12px;
    }

    .c-submenu__list {
      display: none;
      padding-left: 32px;
    }

    .c-submenu__list .c-menu__link {
      border-bottom: none;
      padding: 12px 20px;
      font-size: 16px;
    }

    .c-submenu__list.is-expanded {
      display: block;
    }

    .c-menu__sublink .icon {
      transition: transform 0.2s;
    }

    .icon {
      width: 18px;
      height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .c-submenu__btn .icon {
      transform: rotate(90deg);
    }

    .c-menu__acct {
      background: #fcfcfc;
    }

    .c-submenu .js-submenu__back-nav-wrapper {
      padding: 16px 12px !important;
      font-size: 14px;
      background: #fcfcfc;
      border-bottom: none !important;
    }

    .c-submenu .js-submenu__back-nav-wrapper h4 {
      margin: 0.3rem 0px;
      font-weight: 500;
    }

    .o-list-plain .c-submenu__list li {
      padding: 6px 10px;
      list-style: none;
    }

    .c-menu__sublink[aria-expanded="true"] .icon {
      transform: rotate(45deg);
    }

    .c-menu__cs .c-menu__link {
      border-bottom: none;
    }

    /* 移动端搜索框样式 */
    #{{ section_id }} .gmk-lulus-header__mobile-search {
      display: none;
      margin: 12px 16px;
    }

    #{{ section_id }} .gmk-lulus-header__mobile-search .gmk-lulus-header__search {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 0px 10px;
      background: #f7f7f7;
      border-radius: 25px;
      border-bottom: none;
    }

    #{{ section_id }} .gmk-lulus-header__mobile-search .gmk-lulus-header__search-input {
      flex: 1;
      padding: 12px 8px 12px 0;
      font-size: 14px;
    }

    #{{ section_id }} .gmk-lulus-header__market-container {
      display: flex;
    }

    /* ========== 移动端禁用吸顶 ========== */
    @media screen and (max-width: 989px) {
      #{{ section_id }}.gmk-lulus-header--sticky {
        position: static;
      }
    }

    /* 响应式断点：移动端调整 */
    @media screen and (max-width: 989px) {
      .c-menu__link,#{{ section_id }} .o-list-plain .c-submenu__list .gmk-lulus-header__mega-label {
        font-size: 14px;
      }
      #{{ section_id }} .gmk-lulus-header__nav-shell .gmk-lulus-header__nav-list {
        display: none !important;
      }
      #{{ section_id }} .gmk-lulus-header__brand-button-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1 0 50%;
        min-width: 170px;
        height: 45px;
        padding: 10px 18px;
      }
      .c-menu__link--icon .icon {
        width: 24px;
        height: 24px;
      }
      #{{ section_id }} .gmk-lulus-header__menu-toggle {
        display: inline-flex;
        order: -1;
      }
      #{{ section_id }} .gmk-lulus-header__tools {
        justify-content: flex-start;
        gap: 12px;
        padding: 8px 16px;
        background: #fff;
      }
      #{{ section_id }} .gmk-lulus-header__top {
        flex-direction: column;
        min-height: auto;
      }
      #{{ section_id }} .gmk-lulus-header__brands {
        width: 100%;
        min-width: 0;
      }
      #{{ section_id }} .gmk-lulus-header__brand-button {
        flex: 1 0 50%;
        min-width: 170px;
        height: 45px;
        padding: 10px 18px;
      }
      #{{ section_id }} .gmk-lulus-header__icon-button.account-button {
        display: none;
      }
      /* 桌面搜索框隐藏 */
      #{{ section_id }} .gmk-lulus-header__tools .gmk-lulus-header__search {
        display: none;
      }
      /* 移动端搜索框显示 */
      #{{ section_id }} .gmk-lulus-header__mobile-search {
        display: block;
      }
    }
  </style>

  <section
    id="{{ section_id }}"
    class="gmk-lulus-header
    {% if sticky_header %} gmk-lulus-header--sticky{% endif %}"
    data-section-id="{{ section.id }}"
    data-section-type="{{ section.type | escape }}"
    data-default-brand="{{ active_brand_key | escape }}"
    data-collapse-on-scroll="{{ collapse_on_scroll }}"
    data-collapse-offset="{{ collapse_offset }}"
  >
    <div class="gmk-lulus-header__shell">
      <div class="gmk-lulus-header__top">
        <div class="gmk-lulus-header__brands" role="tablist" aria-label="Brand navigation">
          {% for brand_block in section.blocks %}
            {% if brand_block.type == 'brand' %}
              {% liquid
                assign brand_key = brand_block.settings.key | strip
                assign brand_title = brand_block.settings.title | strip
                assign logo_text = brand_block.settings.logo_text | strip
                assign logo_style = brand_block.settings.logo_style
                assign logo_words = logo_text | split: ' '
                assign outlet_prefix = logo_words.first
                assign outlet_main = logo_text | remove_first: outlet_prefix | strip
                assign brand_is_active = false
                if brand_key == active_brand_key
                  assign brand_is_active = true
                endif
              %}
              {% if brand_key != blank and brand_title != blank %}
                <button
                  type="button"
                  class="gmk-lulus-header__brand-button{% if brand_is_active %} is-active{% endif %}"
                  data-brand-button="{{ brand_key | escape }}"
                  role="tab"
                  aria-selected="{% if brand_is_active %}true{% else %}false{% endif %}"
                  {{ brand_block.shopify_attributes }}
                >
                  {% if brand_block.settings.logo_image != blank %}
                    {{ brand_block.settings.logo_image | image_url: width: 420 | image_tag: loading: 'eager', class: 'gmk-lulus-header__brand-image', alt: brand_title }}
                  {% elsif logo_text != blank %}
                    {% if logo_style == 'outlet' and logo_words.size > 1 %}
                      <span class="gmk-lulus-header__brand-text gmk-lulus-header__brand-text--serif" aria-label="{{ logo_text | escape }}">
                        <span class="gmk-lulus-header__brand-outlet-the">{{ outlet_prefix | escape }}</span>
                        <span class="gmk-lulus-header__brand-outlet-main">{{ outlet_main | escape }}</span>
                      </span>
                    {% else %}
                      <span class="gmk-lulus-header__brand-text gmk-lulus-header__brand-text--{{ logo_style | escape }}">{{ logo_text | escape }}</span>
                    {% endif %}
                  {% else %}
                    <span class="gmk-lulus-header__brand-text gmk-lulus-header__brand-text--classic">{{ brand_title | escape }}</span>
                  {% endif %}
                </button>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        <div class="gmk-lulus-header__tools">
          <!-- 汉堡菜单按钮 -->
          <button class="gmk-lulus-header__icon-button gmk-lulus-header__menu-toggle" type="button" aria-label="Menu" data-mobile-menu-toggle>
            <svg class="icon-hamburger" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12h18M3 6h18M3 18h18"/>
            </svg>
            <svg class="icon-close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>

          <!-- 桌面搜索框（移动端隐藏） -->
          <form class="gmk-lulus-header__search" action="{{ routes.search_url }}" method="get" role="search">
            <input
              class="gmk-lulus-header__search-input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ search_placeholder | escape }}"
              aria-label="{{ search_placeholder | escape }}"
            >
            <button class="gmk-lulus-header__icon-button" type="submit" aria-label="Search">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m16.5 16.5 4 4"></path>
              </svg>
            </button>
          </form>

          <button type="button" class="gmk-lulus-header__brand-button-logo" data-brand-button="lulus" role="tab" aria-selected="true">               
            <span class="gmk-lulus-header__brand-text gmk-lulus-header__brand-text--script">Lulus</span>
          </button>

          <div class="gmk-lulus-header__market-container">
            {% if market_label != blank %}
              <button class="gmk-lulus-header__market" type="button" aria-label="Market selector">{{ market_label | escape }}</button>
            {% endif %}

            {% if account_link != blank %}
              <a class="gmk-lulus-header__icon-button account-button" href="{{ account_link }}" aria-label="Account">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path></svg>
              </a>
            {% endif %}

            {% if wishlist_link != blank %}
              <a class="gmk-lulus-header__icon-button" href="{{ wishlist_link }}" aria-label="Wishlist">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.5 5.8c-1.6-1.7-4.3-1.7-5.9 0L12 8.5 9.4 5.8c-1.6-1.7-4.3-1.7-5.9 0-1.7 1.8-1.7 4.6 0 6.4l8.5 8.8 8.5-8.8c1.7-1.8 1.7-4.6 0-6.4Z"></path></svg>
              </a>
            {% else %}
              <button class="gmk-lulus-header__icon-button" type="button" aria-label="Wishlist">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.5 5.8c-1.6-1.7-4.3-1.7-5.9 0L12 8.5 9.4 5.8c-1.6-1.7-4.3-1.7-5.9 0-1.7 1.8-1.7 4.6 0 6.4l8.5 8.8 8.5-8.8c1.7-1.8 1.7-4.6 0-6.4Z"></path></svg>
              </button>
            {% endif %}

            {% if cart_link != blank %}
              <a class="gmk-lulus-header__icon-button" href="{{ cart_link }}" aria-label="Cart">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6.5 8.5h11l-.7 11H7.2l-.7-11Z"></path><path d="M9 8.5V6a3 3 0 0 1 6 0v2.5"></path></svg>
                <span class="gmk-lulus-header__cart-count">{{ cart.item_count | default: 0 }}</span>
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- 桌面导航栏（移动端会被 CSS 隐藏） -->
      <nav class="gmk-lulus-header__nav-shell" aria-label="Main navigation">
        <div class="gmk-lulus-header__nav-inner">
          <!-- 移动端搜索框容器 -->
          <div class="gmk-lulus-header__mobile-search" data-mobile-search-container></div>

          {% for brand_block in section.blocks %}
            {% if brand_block.type == 'brand' %}
              {% liquid
                assign panel_brand_key = brand_block.settings.key | strip
                assign panel_is_active = false
                if panel_brand_key == active_brand_key
                  assign panel_is_active = true
                endif
              %}
              {% if panel_brand_key != blank %}
                <ul
                  class="gmk-lulus-header__nav-list"
                  data-brand-panel="{{ panel_brand_key | escape }}"
                  {% unless panel_is_active %}hidden{% endunless %}
                >
                  {% for nav_block in section.blocks %}
                    {% if nav_block.type == 'nav_item' %}
                      {% liquid
                        assign nav_brand_key = nav_block.settings.brand_key | strip
                        assign nav_key = nav_block.settings.key | strip
                        assign nav_title = nav_block.settings.title | strip
                        assign nav_link = nav_block.settings.link_url
                        assign has_mega = false
                        assign has_mega_columns = false
                        assign has_mega_promos = false
                      %}
                      {% if nav_brand_key == panel_brand_key and nav_key != blank and nav_title != blank %}
                        {% for mega_check_block in section.blocks %}
                          {% if mega_check_block.type == 'menu_column' and mega_check_block.settings.brand_key == nav_brand_key and mega_check_block.settings.parent_key == nav_key %}
                            {% if mega_check_block.settings.title != blank or mega_check_block.settings.text != blank %}
                              {% assign has_mega = true %}
                              {% assign has_mega_columns = true %}
                            {% endif %}
                          {% elsif mega_check_block.type == 'promo' and mega_check_block.settings.brand_key == nav_brand_key and mega_check_block.settings.parent_key == nav_key %}
                            {% if mega_check_block.settings.image != blank %}
                              {% assign has_mega = true %}
                              {% assign has_mega_promos = true %}
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                        <li
                          class="gmk-lulus-header__nav-item{% if has_mega %} has-mega{% endif %}"
                          data-nav-item
                          data-nav-key="{{ nav_key }}"
                          data-nav-title="{{ nav_title | escape }}"
                          {% if nav_link %}data-nav-url="{{ nav_link }}"{% endif %}
                        >
                          {% if nav_link != blank %}
                            <a class="gmk-lulus-header__nav-link" href="{{ nav_link }}">{{ nav_title | escape }}</a>
                          {% else %}
                            <button type="button" class="gmk-lulus-header__nav-link">{{ nav_title | escape }}</button>
                          {% endif %}
                         <!-- 在桌面导航栏的 nav_item 内部，找到 has_mega 的判断，替换为以下完整内容 -->
{% if has_mega %}
  <div class="gmk-lulus-header__mega" data-mega data-mega-key="{{ nav_key }}">
    <div class="gmk-lulus-header__mega-inner">
      {% if has_mega_columns %}
        <div class="gmk-lulus-header__mega-columns">
          {% for mega_block in section.blocks %}
            {% if mega_block.type == 'menu_column' and mega_block.settings.brand_key == nav_brand_key and mega_block.settings.parent_key == nav_key %}
              {% assign column_title = mega_block.settings.title | strip %}
              {% assign column_text = mega_block.settings.text | strip %}
              {% assign column_style = mega_block.settings.column_style %}
              {% if column_title != blank or column_text != blank %}
                <div class="gmk-lulus-header__mega-column gmk-lulus-header__mega-column--{{ column_style | escape }}">
                  {% if column_title != blank %}
                    <p class="gmk-lulus-header__mega-title">{{ column_title | escape }}</p>
                  {% endif %}
                  {% if column_text != blank %}
                    <ul class="gmk-lulus-header__mega-links">
                      {% assign menu_lines = column_text | newline_to_br | split: '<br />' %}
                      {% for menu_line in menu_lines %}
                        {% assign clean_line = menu_line | strip %}
                        {% assign heading_marker = clean_line | slice: 0, 2 %}
                        {% if clean_line != blank %}
                          {% if heading_marker == '# ' %}
                            <li><p class="gmk-lulus-header__mega-subtitle">{{ clean_line | remove_first: '# ' | strip | escape }}</p></li>
                          {% else %}
                            {% assign line_parts = clean_line | split: '|' %}
                            {% assign line_label = line_parts[0] | strip %}
                            {% assign line_url = line_parts[1] | strip %}
                            <li>
                              {% if line_url != blank %}
                                <a class="gmk-lulus-header__mega-link" href="{{ line_url }}">{{ line_label | escape }}</a>
                              {% else %}
                                <span class="gmk-lulus-header__mega-label">{{ line_label | escape }}</span>
                              {% endif %}
                            </li>
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% comment %} # 桌面端显示 promo 图片模块 # {% endcomment %}
      {% if has_mega_promos %}
        <div class="gmk-lulus-header__promos">
          {% for promo_block in section.blocks %}
            {% if promo_block.type == 'promo' and promo_block.settings.brand_key == nav_brand_key and promo_block.settings.parent_key == nav_key and promo_block.settings.image != blank %}
              {% assign promo_title = promo_block.settings.title | strip %}
              {% assign promo_link = promo_block.settings.link_url %}
              {% assign image_ratio = promo_block.settings.image_ratio %}
              <div class="gmk-lulus-header__promo">
                {% if promo_link != blank %}<a class="gmk-lulus-header__promo-link" href="{{ promo_link }}">{% endif %}
                  <div class="gmk-lulus-header__promo-media gmk-lulus-header__promo-media--{{ image_ratio | escape }}">
                    {{ promo_block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', class: 'gmk-lulus-header__promo-image', alt: promo_title }}
                  </div>
                  {% if promo_title != blank %}<p class="gmk-lulus-header__promo-title">{{ promo_title | escape }}</p>{% endif %}
                {% if promo_link != blank %}</a>{% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
                        </li>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </nav>
    </div>

    <!-- 移动端遮罩 + 抽屉（左侧滑出） -->
    <div class="gmk-lulus-header__drawer-overlay" data-drawer-overlay></div>
    <div class="gmk-lulus-header__mobile-drawer" data-mobile-drawer>
      <div class="c-site-nav-mobile__list" data-mobile-nav-container></div>
    </div>
  </section>

  <script>
    (() => {
      const root = document.getElementById({{ section_id | json }});
      if (!root || root.dataset.gmkLulusHeaderReady === 'true') return;
      root.dataset.gmkLulusHeaderReady = 'true';

      const brandButtons = Array.from(root.querySelectorAll('[data-brand-button]'));
      const brandPanels = Array.from(root.querySelectorAll('[data-brand-panel]'));
      const collapseOnScroll = root.dataset.collapseOnScroll === 'true';
      const collapseOffset = Number(root.dataset.collapseOffset || 80);

      // 移动端元素
      const menuToggle = root.querySelector('[data-mobile-menu-toggle]');
      const hamburgerIcon = menuToggle?.querySelector('.icon-hamburger');
      const closeIcon = menuToggle?.querySelector('.icon-close');
      const drawer = root.querySelector('[data-mobile-drawer]');
      const drawerOverlay = root.querySelector('[data-drawer-overlay]');
      const mobileNavContainer = root.querySelector('[data-mobile-nav-container]');
      const drawerCloseBtn = root.querySelector('[data-drawer-close]');
      const mobileSearchContainer = root.querySelector('[data-mobile-search-container]');

      let currentActiveBrand = null;
      let isDrawerOpen = false;

      // 获取 header 实际高度（.gmk-lulus-header__top + .announcement-bar）
      const getHeaderHeight = () => {
        const headerTop = root.querySelector('.gmk-lulus-header__top');
        const announcementBar = document.querySelector('.announcement-bar');
        let height = 0;
        if (headerTop) height += headerTop.offsetHeight;
        if (announcementBar && announcementBar.offsetHeight) height += announcementBar.offsetHeight;
        return height;
      };

      // 更新遮罩层 top 值，使其不覆盖 header 区域
      const updateOverlayTop = () => {
        if (!drawerOverlay) return;
        const headerHeight = getHeaderHeight();
        drawerOverlay.style.top = `${headerHeight}px`;
      };

      // 重置遮罩层 top 为 0
      const resetOverlayTop = () => {
        if (!drawerOverlay) return;
        drawerOverlay.style.top = '0';
      };

      // 更新抽屉 top 位置（使其紧贴 header 下方）
      const updateDrawerTop = () => {
        if (!drawer) return;
        const headerHeight = getHeaderHeight();
        drawer.style.top = `${headerHeight}px`;
      };

      // 克隆搜索框到移动端容器（只执行一次）
      const moveSearchToMobile = () => {
        if (!mobileSearchContainer) return;
        if (mobileSearchContainer.querySelector('.gmk-lulus-header__search')) return;
        const desktopSearch = root.querySelector('.gmk-lulus-header__tools .gmk-lulus-header__search');
        if (!desktopSearch) return;
        const clonedSearch = desktopSearch.cloneNode(true);
        mobileSearchContainer.appendChild(clonedSearch);
      };

      // 关闭抽屉
      const closeDrawer = () => {
        if (!drawer) return;
        drawer.classList.remove('is-open');
        drawerOverlay.classList.remove('is-active');
        document.body.style.overflow = '';
        isDrawerOpen = false;
        resetOverlayTop();
        if (hamburgerIcon && closeIcon) {
          hamburgerIcon.style.display = '';
          closeIcon.style.display = 'none';
        }
        // 重置子菜单显示
        if (mobileNavContainer) {
          const mainMenu = mobileNavContainer.querySelector('.c-menu');
          const allSubmenus = mobileNavContainer.querySelectorAll('.c-submenu');
          if (mainMenu) mainMenu.style.display = '';
          allSubmenus.forEach(sub => sub.classList.remove('is-active'));
        }
      };

      // 打开抽屉
      const openDrawer = () => {
        if (!drawer || !drawerOverlay) return;
        // 计算并设置抽屉 top
        updateDrawerTop();
        // 设置遮罩 top 为 header 高度，避免覆盖工具栏
        updateOverlayTop();
        refreshMobileNav(currentActiveBrand);
        drawer.classList.add('is-open');
        drawerOverlay.classList.add('is-active');
        document.body.style.overflow = 'hidden';
        isDrawerOpen = true;
        if (hamburgerIcon && closeIcon) {
          hamburgerIcon.style.display = 'none';
          closeIcon.style.display = '';
        }
      };

      // 生成子菜单HTML（不包含 promo 图片）
      const generateSubmenuHtml = (title, megaElement, navKey) => {
        const cloneMega = megaElement.cloneNode(true);
        const columns = Array.from(cloneMega.querySelectorAll('.gmk-lulus-header__mega-column'));
        const ul = document.createElement('ul');
        ul.className = 'o-list-plain';

        columns.forEach(col => {
          const titleEl = col.querySelector('.gmk-lulus-header__mega-title');
          const groupTitle = titleEl ? titleEl.innerText.trim() : '';
          const linksUl = col.querySelector('.gmk-lulus-header__mega-links');
          if (!linksUl || linksUl.children.length === 0) return;

          const li = document.createElement('li');
          li.setAttribute('role', 'none');
          
          const sublinkBtn = document.createElement('button');
          sublinkBtn.className = 'c-menu__link c-menu__sublink';
          sublinkBtn.setAttribute('aria-expanded', 'false');
          sublinkBtn.innerHTML = `<span>${escapeHtml(groupTitle)}</span><span aria-hidden="true" class="icon icon-plus-thin"><svg class="icon icon-arrow icon--small" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.5 3.74121L13.75 9.99121L7.5 16.2412" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>`;
          
          const sublist = document.createElement('ul');
          sublist.className = 'c-submenu__list';
          sublist.style.display = 'none';
          
          Array.from(linksUl.children).forEach(liItem => {
            const cloned = liItem.cloneNode(true);
            const linkEl = cloned.querySelector('a');
            if (linkEl) linkEl.addEventListener('click', () => closeDrawer());
            const subLi = document.createElement('li');
            subLi.setAttribute('role', 'none');
            subLi.appendChild(cloned);
            sublist.appendChild(subLi);
          });
          
          sublinkBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const expanded = sublinkBtn.getAttribute('aria-expanded') === 'true';
            sublinkBtn.setAttribute('aria-expanded', !expanded);
            sublist.style.display = !expanded ? 'block' : 'none';
          });
          
          li.appendChild(sublinkBtn);
          li.appendChild(sublist);
          ul.appendChild(li);
        });

        const submenuDiv = document.createElement('div');
        submenuDiv.id = `submenu_${navKey}`;
        submenuDiv.className = 'c-submenu';
        
        const backWrapper = document.createElement('div');
        backWrapper.className = 'o-flex u-pad-vert js-submenu__back-nav-wrapper';
        backWrapper.style.display = 'flex';
        backWrapper.style.alignItems = 'center';
        backWrapper.style.padding = '12px 16px';
        backWrapper.style.borderBottom = '1px solid var(--gmk-lulus-header-border)';
        
        const backBtn = document.createElement('button');
        backBtn.className = 'c-submenu__btn c-btn--plain';
        backBtn.setAttribute('aria-label', 'Return to main navigation menu');
        backBtn.innerHTML = '<span aria-hidden="true" class="icon icon-arrow-left"><svg class="icon icon-arrow icon--small" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.5 3.74121L13.75 9.99121L7.5 16.2412" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>';
        backBtn.addEventListener('click', () => {
          const mainMenu = mobileNavContainer.querySelector('.c-menu');
          submenuDiv.classList.remove('is-active');
          if (mainMenu) mainMenu.style.display = '';
        });
        
        const heading = document.createElement('h4');
        heading.className = 'u-text-sm u-margin-none u-text-bold c-heading-h5 u-wide u-margin-left';
        heading.innerText = title;
        
        backWrapper.appendChild(backBtn);
        backWrapper.appendChild(heading);
        submenuDiv.appendChild(backWrapper);
        
        const ulContainer = document.createElement('ul');
        ulContainer.setAttribute('role', 'menu');
        ulContainer.setAttribute('aria-label', `${title} Menu`);
        ulContainer.className = 'o-list-plain';
        ulContainer.appendChild(ul);
        submenuDiv.appendChild(ulContainer);
        
        return submenuDiv;
      };

      // 生成主菜单
      const generateMainMenuHtml = (brandKey) => {
        const activePanel = brandPanels.find(panel => panel.dataset.brandPanel === brandKey && !panel.hidden);
        if (!activePanel) return document.createDocumentFragment();
        
        const navItems = Array.from(activePanel.querySelectorAll(':scope > .gmk-lulus-header__nav-item'));
        const fragment = document.createDocumentFragment();
        
        const ul = document.createElement('ul');
        ul.setAttribute('role', 'menu');
        ul.setAttribute('aria-label', 'Main Navigation');
        ul.className = 'o-list-plain c-menu';
        
        // 账户区域
        const accountLi = document.createElement('li');
        accountLi.setAttribute('role', 'none');
        accountLi.innerHTML = `
          <div class="c-menu__acct u-bg-gray">
            <button class="c-menu__link c-menu__link--icon" aria-expanded="false" aria-haspopup="true">
              <div class="o-flex-col">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path></svg>
                <div class="o-flex-col"><span>Sign In</span></div>
              </div>
              <span aria-hidden="true" class="icon icon-plus-thin">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
            <div class="c-menu__acct-list" style="display: none;">
              <a href="{{ routes.account_login_url }}" rel="nofollow" class="c-menu__link">Sign In</a>
              <a href="{{ routes.account_register_url }}" rel="nofollow" class="c-menu__link">Create Account</a>
              <a href="/returns" rel="nofollow" class="c-menu__link">Initiate Return</a>
              <a href="/orders" rel="nofollow" class="c-menu__link">Track Your Order</a>
            </div>
          </div>
        `;
        ul.appendChild(accountLi);
        
        navItems.forEach((item, idx) => {
          const linkEl = item.querySelector(':scope > .gmk-lulus-header__nav-link');
          if (!linkEl) return;
          const title = linkEl.innerText.trim();
          const href = linkEl.tagName === 'A' ? linkEl.getAttribute('href') : null;
          const hasMega = item.classList.contains('has-mega');
          const megaDiv = hasMega ? item.querySelector('.gmk-lulus-header__mega') : null;
          const navKey = `nav_${idx}_${Date.now()}_${Math.random().toString(36).substr(2, 6)}`;
          
          const li = document.createElement('li');
          li.setAttribute('role', 'none');
          
          if (href && !hasMega) {
            const a = document.createElement('a');
            a.className = 'c-menu__link';
            a.href = href;
            a.innerText = title;
            a.addEventListener('click', () => closeDrawer());
            li.appendChild(a);
          } else {
            const btn = document.createElement('button');
            btn.className = 'c-menu__link';
            btn.setAttribute('aria-expanded', 'false');
            btn.setAttribute('aria-haspopup', 'true');
            btn.setAttribute('data-submenu-id', `submenu_${navKey}`);
            btn.innerHTML = `<span>${escapeHtml(title)}</span>`;
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              const submenuId = btn.getAttribute('data-submenu-id');
              const submenu = mobileNavContainer.querySelector(`#${submenuId}`);
              const mainMenu = mobileNavContainer.querySelector('.c-menu');
              if (submenu && mainMenu) {
                mainMenu.style.display = 'none';
                submenu.classList.add('is-active');
              }
            });
            li.appendChild(btn);
            
            if (megaDiv) {
              const submenuHtml = generateSubmenuHtml(title, megaDiv, navKey);
              submenuHtml.id = `submenu_${navKey}`;
              fragment.appendChild(submenuHtml);
            }
          }
          ul.appendChild(li);
        });
        
        // Customer Care
        const csLi = document.createElement('li');
        csLi.setAttribute('role', 'none');
        csLi.innerHTML = `<div class="c-menu__cs"><a href="/customerservice" class="c-menu__link c-menu__link--no-border">Customer Care</a></div>`;
        ul.appendChild(csLi);
        
        fragment.appendChild(ul);
        return fragment;
      };

      const refreshMobileNav = (brandKey) => {
        if (!mobileNavContainer) return;
        mobileNavContainer.innerHTML = '';
        const navContent = generateMainMenuHtml(brandKey);
        mobileNavContainer.appendChild(navContent);
        
        // 绑定账户折叠 + 图标切换
        const acctBtn = mobileNavContainer.querySelector('.c-menu__acct > .c-menu__link');
        if (acctBtn) {
          const acctList = acctBtn.parentElement.querySelector('.c-menu__acct-list');
          const iconSpan = acctBtn.querySelector('.icon-plus-thin');
          acctBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const expanded = acctBtn.getAttribute('aria-expanded') === 'true';
            acctBtn.setAttribute('aria-expanded', !expanded);
            acctList.style.display = !expanded ? 'block' : 'none';
            // 切换图标：加号 ↔ 减号
            if (iconSpan) {
              if (!expanded) {
                // 展开 → 显示减号
                iconSpan.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>`;
              } else {
                // 收起 → 显示加号
                iconSpan.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>`;
              }
            }
          });
        }
      };

      // 品牌切换
      const setBrand = (brandKey) => {
        const selectedKey = brandButtons.some(btn => btn.dataset.brandButton === brandKey) ? brandKey : brandButtons[0]?.dataset.brandButton;
        if (!selectedKey) return;
        currentActiveBrand = selectedKey;
        root.dataset.activeBrand = selectedKey;
        brandButtons.forEach(btn => {
          const isActive = btn.dataset.brandButton === selectedKey;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        brandPanels.forEach(panel => {
          panel.hidden = panel.dataset.brandPanel !== selectedKey;
        });
        if (isDrawerOpen) refreshMobileNav(selectedKey);
      };

      // 初始化
      moveSearchToMobile();
      // 监听窗口大小变化，如果抽屉打开则重新计算抽屉和遮罩位置
      window.addEventListener('resize', () => {
        if (isDrawerOpen) {
          updateDrawerTop();
          updateOverlayTop();
        }
      });
      // 不再监听 scroll 事件，避免滚动时跳动

      brandButtons.forEach(btn => btn.addEventListener('click', () => setBrand(btn.dataset.brandButton)));
      setBrand(root.dataset.defaultBrand);

      // 事件绑定
      if (menuToggle && drawer && drawerOverlay) {
        menuToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          if (isDrawerOpen) closeDrawer();
          else openDrawer();
        });
        if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);
        drawerOverlay.addEventListener('click', closeDrawer);
      }

      // 点击外部关闭抽屉（如果点击事件没有在 root 内）
      document.addEventListener('click', (event) => {
        if (!root.contains(event.target) && isDrawerOpen) closeDrawer();
      });

      if (collapseOnScroll) {
        const syncCondensed = () => root.classList.toggle('is-condensed', window.scrollY > collapseOffset);
        syncCondensed();
        window.addEventListener('scroll', syncCondensed, { passive: true });
      }

      const escapeHtml = (str) => {
        if (!str) return '';
        return str.replace(/[&<>]/g, (m) => {
          if (m === '&') return '&amp;';
          if (m === '<') return '&lt;';
          if (m === '>') return '&gt;';
          return m;
        });
      };
    })();
  </script>
{% endif %}


{% comment %}
  Section: GMK Long Text
  Purpose: Pure long-form copy section with an intro line and repeatable text blocks.
  Blocks: item
{% endcomment %}

{% liquid
  assign section_id = 'gmk-long-text-' | append: section.id
  assign enable_section = section.settings.enable_section
  assign anchor_id = section.settings.anchor_id | strip | handleize
  assign section_width = section.settings.section_width
  assign content_max_width = section.settings.content_max_width
  assign text_max_width = section.settings.text_max_width
  assign edge_gutter = section.settings.edge_gutter
  assign intro_text = section.settings.intro_text
  assign intro_plain = intro_text | strip_html | strip
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  assign intro_margin_bottom = section.settings.intro_margin_bottom
  assign item_gap = section.settings.item_gap
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign intro_font_size = section.settings.intro_font_size
  assign title_font_size = section.settings.title_font_size
  assign body_font_size = section.settings.body_font_size
  assign has_items = false
  assign render_section = false

  case section_width
    when 'full'
      assign container_width = '100%'
    when 'wide'
      assign container_width = content_max_width | append: 'px'
    when 'standard'
      assign container_width = '1440px'
    when 'narrow'
      assign container_width = '1180px'
    else
      assign container_width = content_max_width | append: 'px'
  endcase

  if intro_plain != blank
    assign render_section = true
  endif

  for block in section.blocks
    if block.type == 'item'
      assign block_title = block.settings.title | strip
      assign block_body_plain = block.settings.body_content | strip_html | strip

      if block_title != blank or block_body_plain != blank
        assign has_items = true
        assign render_section = true
        break
      endif
    endif
  endfor
%}

{% if enable_section and render_section %}
  <style>
    #{{ section_id }} {
      --gmk-long-text-container: {{ container_width }};
      --gmk-long-text-content: {{ content_max_width }}px;
      --gmk-long-text-text: {{ text_max_width }}px;
      --gmk-long-text-edge: {{ edge_gutter }}px;
      --gmk-long-text-padding-top: {{ padding_top }}px;
      --gmk-long-text-padding-bottom: {{ padding_bottom }}px;
      --gmk-long-text-padding-top-mobile: {{ padding_top_mobile }}px;
      --gmk-long-text-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
      --gmk-long-text-intro-gap: {{ intro_margin_bottom }}px;
      --gmk-long-text-item-gap: {{ item_gap }}px;
      --gmk-long-text-bg: {{ background_color }};
      --gmk-long-text-color: {{ text_color }};
      --gmk-long-text-intro-font-size: {{ intro_font_size }}px;
      --gmk-long-text-title-font-size: {{ title_font_size }}px;
      --gmk-long-text-body-font-size: {{ body_font_size }}px;
      width: 100%;
      scroll-margin-top: 72px;
      padding-top: var(--gmk-long-text-padding-top);
      padding-bottom: var(--gmk-long-text-padding-bottom);
      background: var(--gmk-long-text-bg);
      color: var(--gmk-long-text-color);
      font-family: Arial, Helvetica, sans-serif;
      letter-spacing: 0;
    }

    #{{ section_id }} * {
      box-sizing: border-box;
    }

    #{{ section_id }} .gmk-long-text__anchor {
      position: relative;
      top: -72px;
      display: block;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    #{{ section_id }} .gmk-long-text__container {
      width: min(calc(100% - (var(--gmk-long-text-edge) * 2)), var(--gmk-long-text-container));
      margin: 0 auto;
    }

    #{{ section_id }} .gmk-long-text__content {
      width: min(100%, var(--gmk-long-text-content));
      margin: 0 auto;
    }

    #{{ section_id }} .gmk-long-text__text {
      width: min(100%, var(--gmk-long-text-text));
      margin: 0 auto;
    }

    #{{ section_id }} .gmk-long-text__intro {
      width: min(100%, var(--gmk-long-text-text));
      margin: 0 auto var(--gmk-long-text-intro-gap);
      color: var(--gmk-long-text-color);
      font-size: var(--gmk-long-text-intro-font-size);
      font-weight: 400;
      line-height: 1.25;
      text-align: center;
    }

    #{{ section_id }} .gmk-long-text__intro p {
      margin: 0;
    }

    #{{ section_id }} .gmk-long-text__items {
      display: flex;
      flex-direction: column;
      gap: var(--gmk-long-text-item-gap);
      margin: 0;
      padding: 0;
    }

    #{{ section_id }} .gmk-long-text__item {
      display: block;
      min-width: 0;
    }

    #{{ section_id }} .gmk-long-text__title {
      margin: 0 0 24px;
      color: var(--gmk-long-text-color);
      font-size: var(--gmk-long-text-title-font-size);
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: 0;
    }

    #{{ section_id }} .gmk-long-text__body {
      color: var(--gmk-long-text-color);
      font-size: var(--gmk-long-text-body-font-size);
      font-weight: 400;
      line-height: 1.38;
      letter-spacing: 0;
    }

    #{{ section_id }} .gmk-long-text__body p {
      margin: 0;
    }

    #{{ section_id }} .gmk-long-text__body p + p {
      margin-top: 16px;
    }

    @media screen and (max-width: 989px) {
      #{{ section_id }} .gmk-long-text__title {
        margin-bottom: 18px;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        padding-top: var(--gmk-long-text-padding-top-mobile);
        padding-bottom: var(--gmk-long-text-padding-bottom-mobile);
      }

      #{{ section_id }} .gmk-long-text__container {
        width: min(calc(100% - 32px), var(--gmk-long-text-container));
      }

      #{{ section_id }} .gmk-long-text__intro {
        margin-bottom: 36px;
        line-height: 1.35;
      }

      #{{ section_id }} .gmk-long-text__items {
        gap: 40px;
      }

      #{{ section_id }} .gmk-long-text__title {
        margin-bottom: 14px;
        line-height: 1.25;
      }

      #{{ section_id }} .gmk-long-text__body {
        line-height: 1.45;
      }
    }
  </style>

  <section id="{{ section_id }}" class="gmk-long-text">
    {% if anchor_id != blank %}
      <span id="{{ anchor_id }}" class="gmk-long-text__anchor"></span>
    {% endif %}

    <div class="gmk-long-text__container">
      <div class="gmk-long-text__content">
        <div class="gmk-long-text__text">
          {% if intro_plain != blank %}
            <div class="gmk-long-text__intro">{{ intro_text }}</div>
          {% endif %}

          {% if has_items %}
            <div class="gmk-long-text__items">
              {% for block in section.blocks %}
                {% liquid
                  assign block_title = block.settings.title | strip
                  assign block_body = block.settings.body_content
                  assign block_body_plain = block_body | strip_html | strip
                  assign render_item = false

                  if block.type == 'item'
                    if block_title != blank or block_body_plain != blank
                      assign render_item = true
                    endif
                  endif
                %}

                {% if render_item %}
                  <article class="gmk-long-text__item" {{ block.shopify_attributes }}>
                    {% if block_title != blank %}
                      <h2 class="gmk-long-text__title">{{ block_title | escape }}</h2>
                    {% endif %}

                    {% if block_body_plain != blank %}
                      <div class="gmk-long-text__body">{{ block_body }}</div>
                    {% endif %}
                  </article>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "GMK Long Text",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "启用 Section｜Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点 ID｜Anchor ID",
      "info": "小写英文、数字、连字符。Lowercase letters, numbers, and hyphens."
    },
    {
      "type": "header",
      "content": "内容设置｜Content settings"
    },
    {
      "type": "inline_richtext",
      "id": "intro_text",
      "label": "顶部文案｜Intro text",
      "default": "One destination for every dress code. Find your forever plus one for every RSVP."
    },
    {
      "type": "header",
      "content": "布局设置｜Layout settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "区块宽度｜Section width",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "内容最大宽度｜Content max width",
      "min": 960,
      "max": 2400,
      "step": 20,
      "unit": "px",
      "default": 2400
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "文字最大宽度｜Text max width",
      "min": 480,
      "max": 2400,
      "step": 20,
      "unit": "px",
      "default": 2400
    },
    {
      "type": "range",
      "id": "edge_gutter",
      "label": "页面边距｜Edge gutter",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "顶部间距｜Padding top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "底部间距｜Padding bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "移动端顶部间距｜Mobile padding top",
      "min": 0,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "移动端底部间距｜Mobile padding bottom",
      "min": 0,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "intro_margin_bottom",
      "label": "顶部文案下间距｜Intro bottom gap",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "文案组间距｜Item gap",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "样式设置｜Style settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色｜Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色｜Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "intro_font_size",
      "label": "顶部文字字号｜Intro font size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "标题字号｜Title font size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "正文字号｜Body font size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "文案组｜Text item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "标题｜Title"
        },
        {
          "type": "richtext",
          "id": "body_content",
          "label": "正文｜Body"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "GMK Long Text",
      "category": "GMK",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Wedding Guest Dresses",

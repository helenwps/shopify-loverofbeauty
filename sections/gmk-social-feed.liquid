{% comment %}
  Section: GMK Social Feed
  Purpose: Centered text header with clickable social feed image tiles.
  Blocks: item
{% endcomment %}

{% liquid
  assign section_id = 'gmk-social-feed-' | append: section.id
  assign enable_section = section.settings.enable_section
  assign anchor_id = section.settings.anchor_id | strip
  assign section_width = section.settings.section_width
  assign content_max_width = section.settings.content_max_width
  assign edge_gutter = section.settings.edge_gutter
  assign image_gap = section.settings.image_gap
  assign image_ratio_key = section.settings.image_ratio | default: 'square'
  assign mobile_image_ratio_key = section.settings.mobile_image_ratio | default: image_ratio_key
  assign heading = section.settings.heading
  assign heading_plain = heading | strip_html | strip
  assign subtext = section.settings.subtext | strip
  assign button_label = section.settings.button_label | strip
  assign button_url = section.settings.button_url
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign caption_color = section.settings.caption_color
  assign render_section = false
  assign has_intro = false
  assign has_button = false

  case section_width
    when 'full'
      assign container_width = '100%'
    when 'wide'
      assign container_width = content_max_width | append: 'px'
    when 'standard'
      assign container_width = '1440px'
    when 'narrow'
      assign container_width = '1180px'
    else
      assign container_width = content_max_width | append: 'px'
  endcase

  case image_ratio_key
    when 'portrait'
      assign image_ratio = '4 / 5'
    when 'portrait_tall'
      assign image_ratio = '3 / 4'
    when 'landscape'
      assign image_ratio = '4 / 3'
    when 'wide'
      assign image_ratio = '16 / 9'
    else
      assign image_ratio = '1 / 1'
  endcase

  case mobile_image_ratio_key
    when 'portrait'
      assign mobile_image_ratio = '4 / 5'
    when 'portrait_tall'
      assign mobile_image_ratio = '3 / 4'
    when 'landscape'
      assign mobile_image_ratio = '4 / 3'
    when 'wide'
      assign mobile_image_ratio = '16 / 9'
    else
      assign mobile_image_ratio = '1 / 1'
  endcase

  if heading_plain != blank or subtext != blank
    assign has_intro = true
  endif

  if button_label != blank and button_url != blank
    assign has_button = true
    assign has_intro = true
  endif

  for block in section.blocks
    if block.type == 'item' and block.settings.image != blank
      assign render_section = true
      break
    endif
  endfor
%}

{% if enable_section and render_section %}
  <style>
    #{{ section_id }} {
      --gmk-social-feed-container: {{ container_width }};
      --gmk-social-feed-edge: {{ edge_gutter }}px;
      --gmk-social-feed-gap: {{ image_gap }}px;
      --gmk-social-feed-image-ratio: {{ image_ratio }};
      --gmk-social-feed-mobile-image-ratio: {{ mobile_image_ratio }};
      --gmk-social-feed-padding-top: {{ padding_top }}px;
      --gmk-social-feed-padding-bottom: {{ padding_bottom }}px;
      --gmk-social-feed-padding-top-mobile: {{ padding_top_mobile }}px;
      --gmk-social-feed-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
      --gmk-social-feed-bg: {{ background_color }};
      --gmk-social-feed-text: {{ text_color }};
      --gmk-social-feed-caption: {{ caption_color }};
      width: 100%;
      scroll-margin-top: 72px;
      padding-top: var(--gmk-social-feed-padding-top);
      padding-bottom: var(--gmk-social-feed-padding-bottom);
      background: var(--gmk-social-feed-bg);
      color: var(--gmk-social-feed-text);
      font-family: Arial, Helvetica, sans-serif;
      letter-spacing: 0;
    }

    #{{ section_id }} * {
      box-sizing: border-box;
    }

    #{{ section_id }} a {
      color: inherit;
      text-decoration: none;
    }

    #{{ section_id }} .gmk-social-feed__anchor {
      position: relative;
      top: -72px;
      display: block;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    #{{ section_id }} .gmk-social-feed__body {
      width: min(calc(100% - (var(--gmk-social-feed-edge) * 2)), var(--gmk-social-feed-container));
      margin: 0 auto;
    }

    #{{ section_id }} .gmk-social-feed__header {
      width: min(100%, 920px);
      margin: 0 auto 58px;
      text-align: center;
    }

    #{{ section_id }} .gmk-social-feed__heading {
      margin: 0;
      color: var(--gmk-social-feed-text);
      font-size: 36px;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: 0;
    }

    #{{ section_id }} .gmk-social-feed__intro {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: center;
      gap: 0 20px;
      margin: 16px 0 0;
    }

    #{{ section_id }} .gmk-social-feed__subtext {
      margin: 0;
      color: var(--gmk-social-feed-text);
      font-size: 24px;
      font-weight: 400;
      line-height: 1.25;
      letter-spacing: 0;
    }

    #{{ section_id }} .gmk-social-feed__button {
      display: inline-flex;
      max-width: 100%;
      color: var(--gmk-social-feed-text);
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
      text-decoration-line: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
      overflow-wrap: anywhere;
    }

    #{{ section_id }} .gmk-social-feed__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gmk-social-feed-gap);
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #{{ section_id }} .gmk-social-feed__item {
      display: block;
      min-width: 0;
      color: var(--gmk-social-feed-text);
      background: #f4f4f4;
    }

    #{{ section_id }} .gmk-social-feed__media {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: var(--gmk-social-feed-image-ratio);
      overflow: hidden;
      background: #f4f4f4;
    }

    #{{ section_id }} .gmk-social-feed__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      transform: scale(1);
      transition: transform 320ms ease;
    }

    #{{ section_id }} a.gmk-social-feed__item:hover .gmk-social-feed__image {
      transform: scale(1.025);
    }

    #{{ section_id }} .gmk-social-feed__caption {
      position: absolute;
      right: 16px;
      bottom: 14px;
      left: 16px;
      z-index: 2;
      color: var(--gmk-social-feed-caption);
      font-size: 16px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.42);
      overflow-wrap: anywhere;
    }

    @media screen and (max-width: 989px) {
      #{{ section_id }} .gmk-social-feed__header {
        margin-bottom: 40px;
      }

      #{{ section_id }} .gmk-social-feed__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        overflow: hidden;
        padding-top: var(--gmk-social-feed-padding-top-mobile);
        padding-bottom: var(--gmk-social-feed-padding-bottom-mobile);
      }

      #{{ section_id }} .gmk-social-feed__body {
        width: 100%;
      }

      #{{ section_id }} .gmk-social-feed__header {
        width: min(calc(100% - 32px), 520px);
        margin-bottom: 30px;
      }

      #{{ section_id }} .gmk-social-feed__heading {
        font-size: 28px;
      }

      #{{ section_id }} .gmk-social-feed__intro {
        gap: 8px 14px;
        margin-top: 10px;
      }

      #{{ section_id }} .gmk-social-feed__subtext,
      #{{ section_id }} .gmk-social-feed__button {
        font-size: 17px;
      }

      #{{ section_id }} .gmk-social-feed__grid {
        display: flex;
        gap: 4px;
        padding: 0 16px;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }

      #{{ section_id }} .gmk-social-feed__grid::-webkit-scrollbar {
        display: none;
      }

      #{{ section_id }} .gmk-social-feed__item {
        {% comment %} flex: 0 0 min(76vw, 360px); {% endcomment %}
        flex-basis: min(25vw, 320px);
        scroll-snap-align: start;
      }

      #{{ section_id }} .gmk-social-feed__media {
        aspect-ratio: var(--gmk-social-feed-mobile-image-ratio);
      }

      #{{ section_id }} .gmk-social-feed__caption {
        right: 12px;
        bottom: 12px;
        left: 12px;
        font-size: 14px;
      }
    }
  </style>

  <section
    id="{{ section_id }}"
    class="gmk-social-feed"
    data-section-id="{{ section.id }}"
    data-section-type="{{ section.type | escape }}"
  >
    {% if anchor_id != blank %}
      <span id="{{ anchor_id | escape }}" class="gmk-social-feed__anchor" aria-hidden="true"></span>
    {% endif %}

    <div class="gmk-social-feed__body">
      {% if has_intro %}
        <div class="gmk-social-feed__header">
          {% if heading_plain != blank %}
            <h2 class="gmk-social-feed__heading">{{ heading }}</h2>
          {% endif %}

          {% if subtext != blank or has_button %}
            <div class="gmk-social-feed__intro">
              {% if subtext != blank %}
                <p class="gmk-social-feed__subtext">{{ subtext }}</p>
              {% endif %}

              {% if has_button %}
                <a class="gmk-social-feed__button" href="{{ button_url }}">{{ button_label }}</a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="gmk-social-feed__grid">
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            {% liquid
              assign image = block.settings.image
              assign caption = block.settings.caption | strip
              assign link_url = block.settings.link_url
              assign image_alt = image.alt | default: caption
            %}

            {% if image != blank %}
              {% if link_url != blank %}
                <a class="gmk-social-feed__item" href="{{ link_url }}" {{ block.shopify_attributes }}>
              {% else %}
                <div class="gmk-social-feed__item" {{ block.shopify_attributes }}>
              {% endif %}
                  <picture class="gmk-social-feed__media">
                    <img
                      class="gmk-social-feed__image"
                      src="{{ image | image_url: width: 1000 }}"
                      srcset="
                        {{ image | image_url: width: 420 }} 420w,
                        {{ image | image_url: width: 720 }} 720w,
                        {{ image | image_url: width: 1000 }} 1000w,
                        {{ image | image_url: width: 1400 }} 1400w
                      "
                      sizes="(min-width: 990px) 24vw, (min-width: 750px) 48vw, 76vw"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      alt="{{ image_alt | escape }}"
                      loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                      decoding="async"
                      {% if image.presentation.focal_point != blank %}
                        style="object-position: {{ image.presentation.focal_point }};"
                      {% endif %}
                    >

                    {% if caption != blank %}
                      <span class="gmk-social-feed__caption">{{ caption }}</span>
                    {% endif %}
                  </picture>
              {% if link_url != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "GMK Social Feed",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "启用 Section / Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点 ID / Anchor ID",
      "info": "小写英文、数字、连字符 / Lowercase letters, numbers, and hyphens."
    },
    {
      "type": "header",
      "content": "内容设置 / Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "标题 / Heading",
      "default": "Shop Our Feed"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "副标题 / Subtext",
      "default": "Cute on our socials, even cuter in your closet"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "链接文字 / Link label",
      "default": "Get Inspired"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "链接 / Link"
    },
    {
      "type": "header",
      "content": "布局设置 / Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "区块宽度 / Section width",
      "default": "wide",
      "options": [
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "内容最大宽度 / Content max width",
      "min": 960,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1920
    },
    {
      "type": "range",
      "id": "edge_gutter",
      "label": "页面边距 / Edge gutter",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "图片间距 / Image gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "桌面图片比例 / Desktop image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "1:1"
        },
        {
          "value": "portrait",
          "label": "4:5"
        },
        {
          "value": "portrait_tall",
          "label": "3:4"
        },
        {
          "value": "landscape",
          "label": "4:3"
        },
        {
          "value": "wide",
          "label": "16:9"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "移动端图片比例 / Mobile image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "1:1"
        },
        {
          "value": "portrait",
          "label": "4:5"
        },
        {
          "value": "portrait_tall",
          "label": "3:4"
        },
        {
          "value": "landscape",
          "label": "4:3"
        },
        {
          "value": "wide",
          "label": "16:9"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "顶部间距 / Padding top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "底部间距 / Padding bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "移动端顶部间距 / Mobile padding top",
      "min": 0,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "移动端底部间距 / Mobile padding bottom",
      "min": 0,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "样式设置 / Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色 / Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色 / Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "图片文字颜色 / Caption color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "图片 / Image",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片 / Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "图片文字 / Caption"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "图片链接 / Image link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "GMK Social Feed",
      "category": "GMK",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}

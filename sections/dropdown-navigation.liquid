<!-- Dropdown Navigation Section - Fullscreen Mega Menu with Slide Down Effect -->
<div class="dropdown-navigation" id="dropdownNav">
  <!-- Mobile Toggle Button -->
  <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <!-- Navigation Container -->
  <nav class="dropdown-nav-container" id="navContainer">
    <div class="nav-content">
      {% for block in section.blocks %}
        {% if block.type == 'menu_item' %}
          <div class="dropdown-menu-item">
            <button class="dropdown-trigger" aria-expanded="false" aria-label="Toggle {{ block.settings.menu_title }} menu">
              <span class="menu-title">{{ block.settings.menu_title }}</span>
            </button>
            
            <div class="dropdown-content">
              <div class="dropdown-inner">
                <!-- Dynamic menu columns -->
                <div class="menu-columns">
                  {% if block.settings.column_1_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_1_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_1 = block.settings.column_1_items | split: '
' %}
                        {% for item in items_1 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_2_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_2_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_2 = block.settings.column_2_items | split: '
' %}
                        {% for item in items_2 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_3_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_3_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_3 = block.settings.column_3_items | split: '
' %}
                        {% for item in items_3 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_4_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_4_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_4 = block.settings.column_4_items | split: '
' %}
                        {% for item in items_4 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_5_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_5_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_5 = block.settings.column_5_items | split: '
' %}
                        {% for item in items_5 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                </div>
                
                <!-- Clickable Image -->
                {% if block.settings.menu_image %}
                  <div class="menu-image-wrapper">
                    <div class="menu-image-container">
                      <a href="{{ block.settings.image_link }}" class="menu-image-link">
                        <img 
                          src="{{ block.settings.menu_image | image_url: width: 250 }}"
                          alt="{{ block.settings.menu_image.alt }}"
                          width="250"
                          height="250"
                          class="menu-image"
                          loading="lazy"
                        />
                      </a>
                    </div>
                    {% if block.settings.image_caption %}
                      <p class="image-caption">{{ block.settings.image_caption }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="menuOverlay"></div>
</div>

<style>
  :root {
    --nav-bg: {{ section.settings.nav_background }};
    --text-color: {{ section.settings.text_color }};
    --hover-color: {{ section.settings.hover_color }};
    --link-color: {{ section.settings.link_color }};
    --link-hover-color: {{ section.settings.link_hover_color }};
    --border-color: {{ section.settings.border_color }};
    --column-title-color: {{ section.settings.column_title_color }};
  }

  .dropdown-navigation {
    width: 100%;
    background-color: var(--nav-bg);
    position: relative; /* 关键：作为全屏下拉菜单的定位参考 */
    border-bottom: 1px solid var(--border-color);
    z-index: 100;
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    background: none;
    border: none;
    cursor: pointer;
    padding: 1rem;
    gap: 6px;
    position: relative;
    z-index: 1001;
  }

  .hamburger-line {
    width: 24px;
    height: 3px;
    background-color: var(--text-color);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(10px, 10px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .dropdown-nav-container {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
    padding: {{ section.settings.nav_padding }};
    max-width: 100%;
    margin: 0 auto;
  }

  .nav-content {
    display: flex;
    width: 100%;
    gap: 2rem;
    flex-wrap: wrap;
  }

  /* PC端菜单项 - 取消自身相对定位，让下拉菜单相对导航栏全屏定位 */
  .dropdown-menu-item {
    position: static;
  }

  .dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-weight: {{ section.settings.menu_font_weight }};
    color: var(--text-color);
    transition: all 0.3s ease;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    position: relative;
  }

  .dropdown-trigger:hover {
    color: var(--hover-color);
    border-bottom-color: var(--hover-color);
  }

  /* 高亮当前悬停的菜单标题 */
  .dropdown-menu-item:hover .dropdown-trigger {
    color: var(--hover-color);
    border-bottom-color: var(--hover-color);
  }

  .dropdown-trigger[aria-expanded="true"] {
    color: var(--hover-color);
    border-bottom-color: var(--hover-color);
  }

  {% comment %} .dropdown-trigger[aria-expanded="true"] .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-icon {
    transition: transform 0.3s ease;
  } {% endcomment %}

  /* PC端全屏下拉菜单 - 从上往下的滑动渐变效果 */
  /* 在原有 :root 样式后替换 .dropdown-content 及相关的样式 */

.dropdown-content {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  width: 100%;
  background-color: white;
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  padding: 2rem;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-20px);
  transition: all 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
  z-index: 1000;
  pointer-events: none;
}

/* JS 控制显示类 */
.dropdown-content.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

/* 保留触发按钮 hover 高亮（同时支持 JS 添加的 .hover 类） */
.dropdown-trigger:hover,
.dropdown-menu-item.hover .dropdown-trigger {
  color: var(--hover-color);
  border-bottom-color: var(--hover-color);
}

/* 防止移动端干扰，移动端样式内保持原有规则 */
@media (max-width: 768px) {
  .dropdown-menu-item:hover .dropdown-content {
    display: none; /* 移动端不启用 hover 显示，完全由 JS 控制 */
  }
  /* 原有移动端样式保持不变，但确保 .show 在移动端不被误用 */
  .dropdown-content.show {
    /* 移动端不适用 PC 的 show 类，由 [open] 属性控制 */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .dropdown-menu-item[open] .dropdown-content {
    opacity: 1 !important;
    visibility: visible !important;
    max-height: 2000px;
    padding: 1.5rem;
    pointer-events: auto;
    transform: none;
  }
}
  /* 全屏内容居中容器 */
  .dropdown-inner {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  .menu-columns {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .menu-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 160px;
  }

  .column-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--column-title-color);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-color);
  }

  .menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-link {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.5rem 0;
    transition: all 0.2s ease;
    position: relative;
    display: inline-block;
  }

  .menu-link:hover {
    color: var(--link-hover-color);
    transform: translateX(4px);
  }

  .menu-image-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 250px;
    flex-shrink: 0;
  }

  .menu-image-container {
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }};
  }

  .menu-image-link {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .menu-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .menu-image-link:hover .menu-image {
    transform: scale(1.05);
  }

  .image-caption {
    text-align: center;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--column-title-color);
    margin: 0;
  }

  .mobile-menu-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .mobile-menu-overlay.active {
    display: block;
  }

  /* Tablet Breakpoint (1024px and below) */
  @media (max-width: 1024px) {
    .menu-columns {
      gap: 1.5rem;
    }

    .dropdown-content {
      padding: 1.5rem;
    }

    .dropdown-inner {
      gap: 1.5rem;
      max-width: 960px;
    }
    
    .menu-column {
      min-width: 140px;
    }
  }

  /* Mobile Breakpoint (768px and below) - 恢复移动端折叠菜单样式 */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .dropdown-nav-container {
      position: fixed;
      top: 60px;
      left: 0;
      width: 100%;
      max-height: calc(100vh - 60px);
      overflow-y: auto;
      background-color: white;
      flex-direction: column;
      padding: 0;
      gap: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-20px);
      transition: all 0.3s ease;
      z-index: 1000;
    }

    .dropdown-nav-container.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-content {
      flex-direction: column;
      width: 100%;
      gap: 0;
    }

    /* 移动端菜单项恢复相对定位，取消全屏效果 */
    .dropdown-menu-item {
      position: relative;
      width: 100%;
      border-bottom: 1px solid var(--border-color);
    }

    /* 移动端取消hover全屏效果 */
    .dropdown-menu-item:hover .dropdown-content {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-20px);
      pointer-events: none;
    }

    .dropdown-trigger {
      width: 100%;
      padding: 1rem;
      border-radius: 0;
      justify-content: space-between;
      border-bottom: none;
    }

    .dropdown-content {
      position: static;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      transform: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      margin: 0;
      padding: 0;
      background-color: #f9f9f9;
      min-width: 100%;
      transition: max-height 0.3s ease, padding 0.3s ease, opacity 0.2s ease;
      pointer-events: none;
    }

    .dropdown-menu-item[open] .dropdown-content {
      opacity: 1;
      visibility: visible;
      max-height: 2000px;
      padding: 1.5rem;
      pointer-events: auto;
      transform: none;
    }

    .dropdown-inner {
      flex-direction: column;
      gap: 1.5rem;
      max-width: 100%;
    }

    .menu-columns {
      flex-direction: column;
      gap: 1rem;
    }

    .menu-image-wrapper {
      min-width: 100%;
    }

    .menu-image {
      max-width: 100%;
    }
  }

  /* Small Mobile (480px and below) */
  @media (max-width: 480px) {
    .mobile-menu-toggle {
      padding: 0.75rem;
    }

    .hamburger-line {
      width: 20px;
      height: 2px;
    }

    .dropdown-trigger {
      font-size: 0.9rem;
      padding: 0.75rem;
    }

    .menu-link {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const navContainer = document.getElementById('navContainer');
    const menuOverlay = document.getElementById('menuOverlay');
    const triggers = document.querySelectorAll('.dropdown-trigger');
  
    // ---------- PC 端 Hover 交互 (宽度 > 768px) ----------
    function initPCHover() {
      if (window.innerWidth <= 768) return;
      
      const menuItems = document.querySelectorAll('.dropdown-menu-item');
      
      menuItems.forEach(item => {
        const trigger = item.querySelector('.dropdown-trigger');
        const content = item.querySelector('.dropdown-content');
        if (!content) return;
        
        // 鼠标进入菜单项（包括触发按钮）显示下拉
        const showMenu = () => {
          // 关闭其他所有菜单
          menuItems.forEach(other => {
            if (other !== item) {
              other.classList.remove('hover');
              other.querySelector('.dropdown-content')?.classList.remove('show');
            }
          });
          item.classList.add('hover');
          content.classList.add('show');
        };
        
        const hideMenu = () => {
          item.classList.remove('hover');
          content.classList.remove('show');
        };
        
        // 监听触发按钮和整个菜单项区域的进入/离开
        item.addEventListener('mouseenter', showMenu);
        item.addEventListener('mouseleave', hideMenu);
        // 关键：下拉内容本身也要监听，防止鼠标移动到内容上时因为父容器离开而关闭
        content.addEventListener('mouseenter', showMenu);
        content.addEventListener('mouseleave', hideMenu);
      });
    }
    
    // 响应窗口大小变化，重新初始化 PC hover 绑定（解除旧的监听）
    let pcHandlersBound = false;
    function bindPCHover() {
      if (window.innerWidth > 768) {
        if (!pcHandlersBound) {
          initPCHover();
          pcHandlersBound = true;
        }
      } else {
        pcHandlersBound = false;
        // 移除 PC 端添加的类，恢复移动端默认状态
        document.querySelectorAll('.dropdown-menu-item').forEach(item => {
          item.classList.remove('hover');
          item.querySelector('.dropdown-content')?.classList.remove('show');
        });
      }
    }
    
    // 初始化 + 监听 resize
    bindPCHover();
    window.addEventListener('resize', () => {
      bindPCHover();
      // 同时处理移动端菜单关闭等原有逻辑
      if (window.innerWidth > 768) {
        mobileToggle?.classList.remove('active');
        navContainer?.classList.remove('active');
        menuOverlay?.classList.remove('active');
        document.body.style.overflow = '';
        document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
          item.removeAttribute('open');
          item.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        });
      }
    });
    
    // ---------- 移动端原有交互保持不变 ----------
    if (mobileToggle) {
      mobileToggle.addEventListener('click', function() {
        this.classList.toggle('active');
        navContainer.classList.toggle('active');
        menuOverlay.classList.toggle('active');
        if (navContainer.classList.contains('active')) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      });
    }
    
    if (menuOverlay) {
      menuOverlay.addEventListener('click', function() {
        mobileToggle?.classList.remove('active');
        navContainer?.classList.remove('active');
        menuOverlay.classList.remove('active');
        document.body.style.overflow = '';
      });
    }
    
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        if (window.innerWidth > 768) {
          // PC 端：阻止按钮默认点击行为，保持纯 hover 交互（无点击展开）
          e.preventDefault();
          return;
        }
        
        // 移动端：原有折叠逻辑
        e.preventDefault();
        const menuItem = this.closest('.dropdown-menu-item');
        const isOpen = menuItem.hasAttribute('open');
        
        document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
          if (item !== menuItem) {
            item.removeAttribute('open');
            item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
          }
        });
        
        if (isOpen) {
          menuItem.removeAttribute('open');
          this.setAttribute('aria-expanded', 'false');
        } else {
          menuItem.setAttribute('open', '');
          this.setAttribute('aria-expanded', 'true');
        }
      });
    });
    
    // 移动端点击外部关闭
    document.addEventListener('click', function(e) {
      if (window.innerWidth <= 768) {
        if (!e.target.closest('.dropdown-menu-item') && !e.target.closest('.mobile-menu-toggle') && !e.target.closest('.mobile-menu-overlay')) {
          document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
            item.removeAttribute('open');
            item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
          });
        }
      }
    });
  });
</script>


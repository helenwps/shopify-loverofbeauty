<!-- Dropdown Navigation Section -->
<div class="dropdown-navigation" id="dropdownNav">
  <!-- Mobile Toggle Button -->
  <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <!-- Navigation Container -->
  <nav class="dropdown-nav-container" id="navContainer">
    <div class="nav-content">
      {% for menu_item in section.blocks %}
        {% if menu_item.type == 'menu_item' %}
          <div class="dropdown-menu-item">
            <button class="dropdown-trigger" aria-expanded="false" aria-label="Toggle {{ menu_item.settings.menu_title }} menu">
              <span class="menu-title">{{ menu_item.settings.menu_title }}</span>
              <svg class="dropdown-icon" width="12" height="8" viewBox="0 0 12 8" fill="none">
                <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            
            <div class="dropdown-content">
              <div class="dropdown-inner">
                <!-- Dynamic menu columns -->
                <div class="menu-columns">
                  {% for column in menu_item.settings.columns %}
                    {% if column != blank and column.column_title != blank %}
                      <div class="menu-column">
                        <h4 class="column-title">{{ column.column_title }}</h4>
                        <ul class="menu-list">
                          {% for link in column.column_links %}
                            {% if link.column_link_text != blank and link.column_link_url != blank %}
                              <li><a href="{{ link.column_link_url }}" class="menu-link">{{ link.column_link_text }}</a></li>
                            {% endif %}
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
                
                <!-- Clickable Image -->
                {% if menu_item.settings.menu_image %}
                  <div class="menu-image-wrapper">
                    <div class="menu-image-container">
                      <a href="{{ menu_item.settings.image_link }}" class="menu-image-link">
                        <img 
                          src="{{ menu_item.settings.menu_image | image_url: width: 250 }}"
                          alt="{{ menu_item.settings.menu_image.alt }}"
                          class="menu-image"
                          loading="lazy"
                        />
                      </a>
                    </div>
                    {% if menu_item.settings.image_caption %}
                      <p class="image-caption">{{ menu_item.settings.image_caption }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="menuOverlay"></div>
</div>

<style>
  :root {
    --nav-bg: {{ section.settings.nav_background }};
    --text-color: {{ section.settings.text_color }};
    --hover-color: {{ section.settings.hover_color }};
    --link-color: {{ section.settings.link_color }};
    --link-hover-color: {{ section.settings.link_hover_color }};
    --border-color: {{ section.settings.border_color }};
    --column-title-color: {{ section.settings.column_title_color }};
  }

  .dropdown-navigation {
    width: 100%;
    background-color: var(--nav-bg);
    position: relative;
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    background: none;
    border: none;
    cursor: pointer;
    padding: 1rem;
    gap: 6px;
    position: relative;
    z-index: 1001;
  }

  .hamburger-line {
    width: 24px;
    height: 3px;
    background-color: var(--text-color);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(10px, 10px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .dropdown-nav-container {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
    padding: {{ section.settings.nav_padding }};
    max-width: 100%;
    margin: 0 auto;
  }

  .nav-content {
    display: flex;
    width: 100%;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .dropdown-menu-item {
    position: relative;
  }

  .dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-weight: {{ section.settings.menu_font_weight }};
    color: var(--text-color);
    transition: all 0.3s ease;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
  }

  .dropdown-trigger:hover {
    color: var(--hover-color);
    border-bottom-color: var(--hover-color);
  }

  .dropdown-trigger[aria-expanded="true"] {
    color: var(--hover-color);
    border-bottom-color: var(--hover-color);
  }

  .dropdown-trigger[aria-expanded="true"] .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-icon {
    transition: transform 0.3s ease;
  }

  /* PC端 - hover时显示菜单 */
  .dropdown-content {
    position: absolute;
    top: 100%;
    left: 0;
    background-color: white;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    min-width: max-content;
    max-width: 90vw;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 1000;
    margin-top: 0.5rem;
    pointer-events: none;
  }

  /* PC端 hover展示 */
  .dropdown-menu-item:hover .dropdown-content {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-inner {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .menu-columns {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .menu-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 150px;
  }

  .column-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--column-title-color);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-color);
  }

  .menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-link {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.5rem 0;
    transition: all 0.2s ease;
    position: relative;
  }

  .menu-link:hover {
    color: var(--link-hover-color);
    padding-left: 0.5rem;
  }

  .menu-image-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 250px;
    flex-shrink: 0;
  }

  .menu-image-container {
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }};
  }

  .menu-image-link {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .menu-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .menu-image-link:hover .menu-image {
    transform: scale(1.05);
  }

  .image-caption {
    text-align: center;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--column-title-color);
    margin: 0;
  }

  .mobile-menu-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .mobile-menu-overlay.active {
    display: block;
  }

  /* Tablet Breakpoint (1024px and below) */
  @media (max-width: 1024px) {
    .menu-columns {
      gap: 1.5rem;
    }

    .dropdown-content {
      padding: 1.5rem;
    }

    .dropdown-inner {
      gap: 1.5rem;
    }
  }

  /* Mobile Breakpoint (768px and below) */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .dropdown-nav-container {
      position: fixed;
      top: 60px;
      left: 0;
      width: 100%;
      max-height: calc(100vh - 60px);
      overflow-y: auto;
      background-color: white;
      flex-direction: column;
      padding: 0;
      gap: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-20px);
      transition: all 0.3s ease;
      z-index: 1000;
    }

    .dropdown-nav-container.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-content {
      flex-direction: column;
      width: 100%;
      gap: 0;
    }

    .dropdown-menu-item {
      width: 100%;
      border-bottom: 1px solid var(--border-color);
    }

    /* 移动端取消hover效果 */
    .dropdown-menu-item:hover .dropdown-content {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      pointer-events: none;
    }

    .dropdown-trigger {
      width: 100%;
      padding: 1rem;
      border-radius: 0;
      justify-content: space-between;
      border-bottom: none;
    }

    .dropdown-content {
      position: static;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      transform: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      margin: 0;
      padding: 0;
      background-color: #f9f9f9;
      min-width: 100%;
      transition: max-height 0.3s ease, padding 0.3s ease;
      pointer-events: none;
    }

    .dropdown-menu-item[open] .dropdown-content {
      opacity: 1;
      visibility: visible;
      max-height: 2000px;
      padding: 1.5rem;
      pointer-events: auto;
    }

    .dropdown-inner {
      flex-direction: column;
      gap: 1.5rem;
    }

    .menu-columns {
      flex-direction: column;
      gap: 1rem;
    }

    .menu-image-wrapper {
      min-width: 100%;
    }

    .menu-image {
      max-width: 100%;
    }
  }

  /* Small Mobile (480px and below) */
  @media (max-width: 480px) {
    .mobile-menu-toggle {
      padding: 0.75rem;
    }

    .hamburger-line {
      width: 20px;
      height: 2px;
    }

    .dropdown-trigger {
      font-size: 0.9rem;
      padding: 0.75rem;
    }

    .menu-link {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const navContainer = document.getElementById('navContainer');
    const menuOverlay = document.getElementById('menuOverlay');
    const triggers = document.querySelectorAll('.dropdown-trigger');

    // Mobile menu toggle
    if (mobileToggle) {
      mobileToggle.addEventListener('click', function() {
        this.classList.toggle('active');
        navContainer.classList.toggle('active');
        menuOverlay.classList.toggle('active');
      });
    }

    // Overlay click to close mobile menu
    if (menuOverlay) {
      menuOverlay.addEventListener('click', function() {
        mobileToggle.classList.remove('active');
        navContainer.classList.remove('active');
        menuOverlay.classList.remove('active');
      });
    }

    // Dropdown menu functionality (for mobile only)
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        // 只在移动端处理点击事件
        if (window.innerWidth > 768) {
          e.preventDefault();
          return;
        }

        e.preventDefault();
        const menuItem = this.closest('.dropdown-menu-item');
        const isOpen = menuItem.hasAttribute('open');
        
        // 关闭其他菜单
        document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
          if (item !== menuItem) {
            item.removeAttribute('open');
            item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
          }
        });
        
        // 切换当前菜单
        if (isOpen) {
          menuItem.removeAttribute('open');
          this.setAttribute('aria-expanded', 'false');
        } else {
          menuItem.setAttribute('open', '');
          this.setAttribute('aria-expanded', 'true');
        }
      });
    });
    
    // 关闭菜单当点击外部（仅限移动端）
    document.addEventListener('click', function(e) {
      if (window.innerWidth <= 768) {
        if (!e.target.closest('.dropdown-menu-item') && !e.target.closest('.mobile-menu-toggle')) {
          document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
            item.removeAttribute('open');
            item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
          });
        }
      }
    });

    // 响应式调整
    window.addEventListener('resize', function() {
      if (window.innerWidth > 768) {
        mobileToggle?.classList.remove('active');
        navContainer?.classList.remove('active');
        menuOverlay?.classList.remove('active');
        // 关闭所有移动端菜单
        document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
          item.removeAttribute('open');
          item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>


<!-- Dropdown Navigation Section -->
<div class="dropdown-navigation" id="dropdownNav">
  <!-- Mobile Toggle Button -->
  <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <!-- Navigation Container -->
  <nav class="dropdown-nav-container" id="navContainer">
    <div class="nav-content">
      {% for block in section.blocks %}
        {% if block.type == 'menu_item' %}
          <div class="dropdown-menu-item" data-menu-id="{{ forloop.index0 }}">
            <button class="dropdown-trigger" aria-expanded="false" aria-label="Toggle {{ block.settings.menu_title }} menu">
              <span class="menu-title">{{ block.settings.menu_title }}</span>
              <svg class="dropdown-icon" width="12" height="8" viewBox="0 0 12 8" fill="none">
                <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            
            <div class="dropdown-content">
              <div class="dropdown-inner">
                <!-- Dynamic menu columns -->
                <div class="menu-columns">
                  {% if block.settings.column_1_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_1_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_1 = block.settings.column_1_items | split: '
' %}
                        {% for item in items_1 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_2_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_2_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_2 = block.settings.column_2_items | split: '
' %}
                        {% for item in items_2 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_3_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_3_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_3 = block.settings.column_3_items | split: '
' %}
                        {% for item in items_3 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_4_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_4_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_4 = block.settings.column_4_items | split: '
' %}
                        {% for item in items_4 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if block.settings.column_5_title != blank %}
                    <div class="menu-column">
                      <h4 class="column-title">{{ block.settings.column_5_title }}</h4>
                      <ul class="menu-list">
                        {% assign items_5 = block.settings.column_5_items | split: '
' %}
                        {% for item in items_5 %}
                          {% if item != blank %}
                            {% assign link_parts = item | split: ':' %}
                            {% if link_parts.size == 2 %}
                              <li><a href="{{ link_parts[1] | strip }}" class="menu-link">{{ link_parts[0] | strip }}</a></li>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                </div>
                
                <!-- Clickable Image -->
                {% if block.settings.menu_image %}
                  <div class="menu-image-wrapper">
                    <div class="menu-image-container">
                      <a href="{{ block.settings.image_link }}" class="menu-image-link">
                        <img 
                          src="{{ block.settings.menu_image | image_url: width: 250 }}"
                          alt="{{ block.settings.menu_image.alt }}"
                          class="menu-image"
                          loading="lazy"
                        />
                      </a>
                    </div>
                    {% if block.settings.image_caption %}
                      <p class="image-caption">{{ block.settings.image_caption }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </nav>

  <!-- Dropdown Overlay (for fullscreen effect) -->
  <div class="dropdown-overlay" id="dropdownOverlay"></div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="menuOverlay"></div>
</div>

<style>
  :root {
    --nav-bg: {{ section.settings.nav_background }};
    --text-color: {{ section.settings.text_color }};
    --hover-color: {{ section.settings.hover_color }};
    --link-color: {{ section.settings.link_color }};
    --link-hover-color: {{ section.settings.link_hover_color }};
    --border-color: {{ section.settings.border_color }};
    --column-title-color: {{ section.settings.column_title_color }};
  }

  .dropdown-navigation {
    width: 100%;
    background-color: var(--nav-bg);
    position: relative;
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    background: none;
    border: none;
    cursor: pointer;
    padding: 1rem;
    gap: 6px;
    position: relative;
    z-index: 1001;
  }

  .hamburger-line {
    width: 24px;
    height: 3px;
    background-color: var(--text-color);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(10px, 10px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .dropdown-nav-container {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
    padding: {{ section.settings.nav_padding }};
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .nav-content {
    display: flex;
    width: 100%;
    gap: 2rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 100;
  }

  .dropdown-menu-item {
    position: relative;
  }

  .dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-weight: {{ section.settings.menu_font_weight }};
    color: var(--text-color);
    transition: all 0.3s ease;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    position: relative;
  }

  .dropdown-trigger:hover {
    color: var(--hover-color);
    border-bottom-color: var(--hover-color);
  }

  .dropdown-trigger.active {
    color: var(--hover-color);
    border-bottom-color: var(--hover-color);
  }

  .dropdown-trigger.active .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-icon {
    transition: transform 0.3s ease;
  }

  /* PC端 - 全屏下拉菜单 */
  .dropdown-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(0, 0, 0, 0.02) 100%);
    z-index: 999;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .dropdown-overlay.active {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  /* PC端 dropdown内容 - 全屏显示 */
  .dropdown-content {
    position: fixed;
    top: 100%;
    left: 0;
    right: 0;
    width: 100vw;
    background-color: white;
    border-bottom: 1px solid var(--border-color);
    padding: 3rem 2rem;
    max-height: 600px;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-30px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1000;
    pointer-events: none;
  }

  /* 从上往下拉的渐变和动画效果 */
  .dropdown-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 30px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
  }

  /* PC端 hover展示 */
  .dropdown-menu-item:hover .dropdown-content {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-menu-item:hover .dropdown-overlay {
    display: block;
    opacity: 1;
  }

  .dropdown-inner {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 菜单列的渐进显示 */
  .menu-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 150px;
    animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1) backwards;
  }

  .menu-column:nth-child(1) {
    animation-delay: 0.05s;
  }

  .menu-column:nth-child(2) {
    animation-delay: 0.1s;
  }

  .menu-column:nth-child(3) {
    animation-delay: 0.15s;
  }

  .menu-column:nth-child(4) {
    animation-delay: 0.2s;
  }

  .menu-column:nth-child(5) {
    animation-delay: 0.25s;
  }

  .column-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--column-title-color);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-color);
  }

  .menu-columns {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-link {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.5rem 0;
    transition: all 0.2s ease;
    position: relative;
  }

  .menu-link:hover {
    color: var(--link-hover-color);
    padding-left: 0.5rem;
  }

  .menu-image-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 250px;
    flex-shrink: 0;
    animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.3s backwards;
  }

  .menu-image-container {
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }};
  }

  .menu-image-link {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .menu-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .menu-image-link:hover .menu-image {
    transform: scale(1.05);
  }

  .image-caption {
    text-align: center;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--column-title-color);
    margin: 0;
  }

  .mobile-menu-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .mobile-menu-overlay.active {
    display: block;
  }

  /* Tablet Breakpoint (1024px and below) */
  @media (max-width: 1024px) {
    .dropdown-content {
      padding: 2rem 1.5rem;
    }

    .dropdown-inner {
      gap: 2rem;
    }

    .menu-columns {
      gap: 1.5rem;
    }
  }

  /* Mobile Breakpoint (768px and below) */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .dropdown-nav-container {
      position: fixed;
      top: 60px;
      left: 0;
      width: 100%;
      max-height: calc(100vh - 60px);
      overflow-y: auto;
      background-color: white;
      flex-direction: column;
      padding: 0;
      gap: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-20px);
      transition: all 0.3s ease;
      z-index: 1000;
    }

    .dropdown-nav-container.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-content {
      flex-direction: column;
      width: 100%;
      gap: 0;
    }

    .dropdown-menu-item {
      width: 100%;
      border-bottom: 1px solid var(--border-color);
    }

    /* 移动端取消hover效果 */
    .dropdown-menu-item:hover .dropdown-content {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      pointer-events: none;
    }

    .dropdown-trigger {
      width: 100%;
      padding: 1rem;
      border-radius: 0;
      justify-content: space-between;
      border-bottom: none;
    }

    /* 移动端 dropdown内容 - 本地展开 */
    .dropdown-content {
      position: static;
      width: auto;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      transform: none;
      border: none;
      border-radius: 0;
      padding: 0;
      background-color: #f9f9f9;
      transition: max-height 0.3s ease, padding 0.3s ease;
      pointer-events: none;
    }

    .dropdown-content::before {
      display: none;
    }

    .dropdown-menu-item[open] .dropdown-content {
      opacity: 1;
      visibility: visible;
      max-height: 2000px;
      padding: 1.5rem;
      pointer-events: auto;
    }

    .dropdown-inner {
      flex-direction: column;
      gap: 1.5rem;
      animation: none;
    }

    .menu-column {
      animation: none;
    }

    .menu-columns {
      flex-direction: column;
      gap: 1rem;
    }

    .menu-image-wrapper {
      min-width: 100%;
      animation: none;
    }

    .menu-image {
      max-width: 100%;
    }
  }

  /* Small Mobile (480px and below) */
  @media (max-width: 480px) {
    .mobile-menu-toggle {
      padding: 0.75rem;
    }

    .hamburger-line {
      width: 20px;
      height: 2px;
    }

    .dropdown-trigger {
      font-size: 0.9rem;
      padding: 0.75rem;
    }

    .menu-link {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const navContainer = document.getElementById('navContainer');
    const menuOverlay = document.getElementById('menuOverlay');
    const dropdownOverlay = document.getElementById('dropdownOverlay');
    const triggers = document.querySelectorAll('.dropdown-trigger');
    const menuItems = document.querySelectorAll('.dropdown-menu-item');

    // Mobile menu toggle
    if (mobileToggle) {
      mobileToggle.addEventListener('click', function() {
        this.classList.toggle('active');
        navContainer.classList.toggle('active');
        menuOverlay.classList.toggle('active');
      });
    }

    // Overlay click to close mobile menu
    if (menuOverlay) {
      menuOverlay.addEventListener('click', function() {
        mobileToggle.classList.remove('active');
        navContainer.classList.remove('active');
        menuOverlay.classList.remove('active');
      });
    }

    // PC端 dropdown hover和高亮功能
    menuItems.forEach((item, index) => {
      const trigger = item.querySelector('.dropdown-trigger');
      
      item.addEventListener('mouseenter', function() {
        if (window.innerWidth > 768) {
          // 激活当前菜单项
          trigger.classList.add('active');
          dropdownOverlay?.classList.add('active');
          
          // 移除其他项的激活状态
          triggers.forEach((t, i) => {
            if (i !== index) {
              t.classList.remove('active');
            }
          });
        }
      });

      item.addEventListener('mouseleave', function() {
        if (window.innerWidth > 768) {
          trigger.classList.remove('active');
          dropdownOverlay?.classList.remove('active');
        }
      });
    });

    // 点击overlay关闭
    if (dropdownOverlay) {
      dropdownOverlay.addEventListener('click', function() {
        triggers.forEach(t => t.classList.remove('active'));
        dropdownOverlay.classList.remove('active');
      });
    }

    // 移动端点击功能
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        // 只在移动端处理点击事件
        if (window.innerWidth > 768) {
          return;
        }

        e.preventDefault();
        const menuItem = this.closest('.dropdown-menu-item');
        const isOpen = menuItem.hasAttribute('open');
        
        // 关闭其他菜单
        document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
          if (item !== menuItem) {
            item.removeAttribute('open');
            item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
          }
        });
        
        // 切换当前菜单
        if (isOpen) {
          menuItem.removeAttribute('open');
          this.setAttribute('aria-expanded', 'false');
        } else {
          menuItem.setAttribute('open', '');
          this.setAttribute('aria-expanded', 'true');
        }
      });
    });
    
    // 关闭菜单当点击外部（仅限移动端）
    document.addEventListener('click', function(e) {
      if (window.innerWidth <= 768) {
        if (!e.target.closest('.dropdown-menu-item') && !e.target.closest('.mobile-menu-toggle')) {
          document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
            item.removeAttribute('open');
            item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
          });
        }
      }
    });

    // 响应式调整
    window.addEventListener('resize', function() {
      if (window.innerWidth > 768) {
        mobileToggle?.classList.remove('active');
        navContainer?.classList.remove('active');
        menuOverlay?.classList.remove('active');
        // 关闭所有移动端菜单
        document.querySelectorAll('.dropdown-menu-item[open]').forEach(item => {
          item.removeAttribute('open');
          item.querySelector('.dropdown-trigger').setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>


      "min": 1,
      "max": 100,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "top_ratio_height",
      "label": "顶部图片比例高｜Top ratio height",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "bottom_ratio_width",
      "label": "底部图片比例宽｜Bottom ratio width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "bottom_ratio_height",
      "label": "底部图片比例高｜Bottom ratio height",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "top_mobile_ratio_width",
      "label": "移动端顶部比例宽｜Mobile top ratio width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 26

{% comment %}
  Section: GMK Promo Images
  Purpose: Clickable promotion image strip with six top tiles and two bottom banners.
  Blocks: top_item, bottom_item
{% endcomment %}

{% liquid
  assign section_id = 'gmk-promo-images-' | append: section.id
  assign enable_section = section.settings.enable_section
  assign anchor_id = section.settings.anchor_id | strip | handleize
  assign section_width = section.settings.section_width
  assign content_max_width = section.settings.content_max_width
  assign edge_gutter = section.settings.edge_gutter
  assign mobile_edge_gutter = section.settings.mobile_edge_gutter
  assign image_gap = section.settings.image_gap
  assign row_gap = section.settings.row_gap
  assign top_ratio_width = section.settings.top_ratio_width | default: 26
  assign top_ratio_height = section.settings.top_ratio_height | default: 10
  assign bottom_ratio_width = section.settings.bottom_ratio_width | default: 16
  assign bottom_ratio_height = section.settings.bottom_ratio_height | default: 1
  assign top_mobile_ratio_width = section.settings.top_mobile_ratio_width | default: 26
  assign top_mobile_ratio_height = section.settings.top_mobile_ratio_height | default: 10
  assign bottom_mobile_ratio_width = section.settings.bottom_mobile_ratio_width | default: 8
  assign bottom_mobile_ratio_height = section.settings.bottom_mobile_ratio_height | default: 1
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  assign background_color = section.settings.background_color
  assign tile_background_color = section.settings.tile_background_color
  assign image_fit = section.settings.image_fit | default: 'cover'
  assign render_top = false
  assign render_bottom = false
  assign render_section = false
  assign top_count = 0
  assign bottom_count = 0

  case section_width
    when 'full'
      assign container_width = '100%'
    when 'wide'
      assign container_width = content_max_width | append: 'px'
    when 'standard'
      assign container_width = '1440px'
    when 'narrow'
      assign container_width = '1180px'
    else
      assign container_width = content_max_width | append: 'px'
  endcase

  for block in section.blocks
    if block.type == 'top_item' and block.settings.image != blank
      assign render_top = true
      assign top_count = top_count | plus: 1
    elsif block.type == 'bottom_item' and block.settings.image != blank
      assign render_bottom = true
      assign bottom_count = bottom_count | plus: 1
    endif
  endfor

  if render_top or render_bottom
    assign render_section = true
  endif

  assign top_columns = top_count
  if top_columns < 1
    assign top_columns = 1
  endif

  assign bottom_columns = bottom_count
  if bottom_columns < 1
    assign bottom_columns = 1
  endif

  assign top_tablet_columns = top_count
  if top_tablet_columns < 1
    assign top_tablet_columns = 1
  endif
  if top_tablet_columns > 3
    assign top_tablet_columns = 3
  endif

  assign top_mobile_columns = top_count
  if top_mobile_columns < 1
    assign top_mobile_columns = 1
  endif
  if top_mobile_columns > 2
    assign top_mobile_columns = 2
  endif

  assign bottom_mobile_columns = bottom_count
  if bottom_mobile_columns < 1
    assign bottom_mobile_columns = 1
  endif
  if bottom_mobile_columns > 1
    assign bottom_mobile_columns = 1
  endif
%}

{% if enable_section and render_section %}
  <style>
    #{{ section_id }} {
      --gmk-promo-images-container: {{ container_width }};
      --gmk-promo-images-edge: {{ edge_gutter }}px;
      --gmk-promo-images-mobile-edge: {{ mobile_edge_gutter }}px;
      --gmk-promo-images-gap: {{ image_gap }}px;
      --gmk-promo-images-row-gap: {{ row_gap }}px;
      --gmk-promo-images-top-ratio: {{ top_ratio_width }} / {{ top_ratio_height }};
      --gmk-promo-images-bottom-ratio: {{ bottom_ratio_width }} / {{ bottom_ratio_height }};
      --gmk-promo-images-top-mobile-ratio: {{ top_mobile_ratio_width }} / {{ top_mobile_ratio_height }};
      --gmk-promo-images-bottom-mobile-ratio: {{ bottom_mobile_ratio_width }} / {{ bottom_mobile_ratio_height }};
      --gmk-promo-images-bg: {{ background_color }};
      --gmk-promo-images-tile-bg: {{ tile_background_color }};
      --gmk-promo-images-fit: {{ image_fit }};
      width: 100%;
      scroll-margin-top: 72px;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      background: var(--gmk-promo-images-bg);
      font-family: Arial, Helvetica, sans-serif;
      letter-spacing: 0;
    }

    #{{ section_id }} * {
      box-sizing: border-box;
    }

    #{{ section_id }} .gmk-promo-images__anchor {
      position: relative;
      top: -72px;
      display: block;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    #{{ section_id }} .gmk-promo-images__body {
      width: min(calc(100% - (var(--gmk-promo-images-edge) * 2)), var(--gmk-promo-images-container));
      margin: 0 auto;
    }

    #{{ section_id }} .gmk-promo-images__row {
      display: grid;
      width: 100%;
      margin: 0;
      padding: 0;
      gap: var(--gmk-promo-images-gap);
      list-style: none;
    }

    #{{ section_id }} .gmk-promo-images__row--top {
      grid-template-columns: repeat({{ top_columns }}, minmax(0, 1fr));
    }

    #{{ section_id }} .gmk-promo-images__row--bottom {
      grid-template-columns: repeat({{ bottom_columns }}, minmax(0, 1fr));
      margin-top: var(--gmk-promo-images-row-gap);
    }

    #{{ section_id }} .gmk-promo-images__row--first {
      margin-top: 0;
    }

    #{{ section_id }} .gmk-promo-images__item {
      display: block;
      min-width: 0;
      overflow: hidden;
      color: inherit;
      text-decoration: none;
      background: var(--gmk-promo-images-tile-bg);
    }

    #{{ section_id }} .gmk-promo-images__item:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: -2px;
    }

    #{{ section_id }} .gmk-promo-images__media {
      display: block;
      width: 100%;
      overflow: hidden;
      background: var(--gmk-promo-images-tile-bg);
    }

    #{{ section_id }} .gmk-promo-images__media--top {
      aspect-ratio: var(--gmk-promo-images-top-ratio);
    }

    #{{ section_id }} .gmk-promo-images__media--bottom {
      aspect-ratio: var(--gmk-promo-images-bottom-ratio);
    }

    #{{ section_id }} .gmk-promo-images__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: var(--gmk-promo-images-fit);
      object-position: center center;
      transform: scale(1);
      transition: transform 260ms ease;
    }

    #{{ section_id }} a.gmk-promo-images__item:hover .gmk-promo-images__image {
      transform: scale(1.015);
    }

    @media screen and (max-width: 989px) {
      #{{ section_id }} .gmk-promo-images__row--top {
        grid-template-columns: repeat({{ top_tablet_columns }}, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        padding-top: {{ padding_top_mobile }}px;
        padding-bottom: {{ padding_bottom_mobile }}px;
      }

      #{{ section_id }} .gmk-promo-images__body {
        width: min(calc(100% - (var(--gmk-promo-images-mobile-edge) * 2)), var(--gmk-promo-images-container));
      }

      #{{ section_id }} .gmk-promo-images__row--top {
        grid-template-columns: repeat({{ top_mobile_columns }}, minmax(0, 1fr));
      }

      #{{ section_id }} .gmk-promo-images__row--bottom {
        grid-template-columns: repeat({{ bottom_mobile_columns }}, minmax(0, 1fr));
      }

      #{{ section_id }} .gmk-promo-images__media--top {
        aspect-ratio: var(--gmk-promo-images-top-mobile-ratio);
      }

      #{{ section_id }} .gmk-promo-images__media--bottom {
        aspect-ratio: var(--gmk-promo-images-bottom-mobile-ratio);
      }
    }
  </style>

  <section
    id="{{ section_id }}"
    class="gmk-promo-images"
    data-section-id="{{ section.id }}"
    data-section-type="{{ section.type | escape }}"
  >
    {% if anchor_id != blank %}
      <span id="{{ anchor_id }}" class="gmk-promo-images__anchor" aria-hidden="true"></span>
    {% endif %}

    <div class="gmk-promo-images__body">
      {% if render_top %}
        <div class="gmk-promo-images__row gmk-promo-images__row--top">
          {% for block in section.blocks %}
            {% if block.type == 'top_item' %}
              {% liquid
                assign image = block.settings.image
                assign link_url = block.settings.link_url
                assign aria_label = block.settings.aria_label | strip
                assign image_alt = image.alt | default: aria_label
                if image_alt == blank
                  assign image_alt = 'Promotion image'
                endif
                assign link_label = aria_label | default: image_alt
              %}

              {% if image != blank %}
                {% if link_url != blank %}
                  <a
                    class="gmk-promo-images__item"
                    href="{{ link_url }}"
                    aria-label="{{ link_label | escape }}"
                    {{ block.shopify_attributes }}
                  >
                {% else %}
                  <div class="gmk-promo-images__item" {{ block.shopify_attributes }}>
                {% endif %}
                    <picture class="gmk-promo-images__media gmk-promo-images__media--top">
                      <img
                        class="gmk-promo-images__image"
                        src="{{ image | image_url: width: 720 }}"
                        srcset="
                          {{ image | image_url: width: 360 }} 360w,
                          {{ image | image_url: width: 520 }} 520w,
                          {{ image | image_url: width: 720 }} 720w,
                          {{ image | image_url: width: 960 }} 960w
                        "
                        sizes="(min-width: 990px) 16.67vw, (min-width: 750px) 33.33vw, 50vw"
                        width="{{ image.width }}"
                        height="{{ image.height }}"
                        alt="{{ image_alt | escape }}"
                        loading="eager"
                        decoding="async"
                        {% if image.presentation.focal_point != blank %}
                          style="object-position: {{ image.presentation.focal_point }};"
                        {% endif %}
                      >
                    </picture>
                {% if link_url != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if render_bottom %}
        <div class="gmk-promo-images__row gmk-promo-images__row--bottom{% unless render_top %} gmk-promo-images__row--first{% endunless %}">
          {% for block in section.blocks %}
            {% if block.type == 'bottom_item' %}
              {% liquid
                assign image = block.settings.image
                assign link_url = block.settings.link_url
                assign aria_label = block.settings.aria_label | strip
                assign image_alt = image.alt | default: aria_label
                if image_alt == blank
                  assign image_alt = 'Promotion image'
                endif
                assign link_label = aria_label | default: image_alt
              %}

              {% if image != blank %}
                {% if link_url != blank %}
                  <a
                    class="gmk-promo-images__item"
                    href="{{ link_url }}"
                    aria-label="{{ link_label | escape }}"
                    {{ block.shopify_attributes }}
                  >
                {% else %}
                  <div class="gmk-promo-images__item" {{ block.shopify_attributes }}>
                {% endif %}
                    <picture class="gmk-promo-images__media gmk-promo-images__media--bottom">
                      <img
                        class="gmk-promo-images__image"
                        src="{{ image | image_url: width: 1600 }}"
                        srcset="
                          {{ image | image_url: width: 720 }} 720w,
                          {{ image | image_url: width: 1000 }} 1000w,
                          {{ image | image_url: width: 1400 }} 1400w,
                          {{ image | image_url: width: 2000 }} 2000w
                        "
                        sizes="(min-width: 990px) 50vw, (min-width: 750px) 50vw, 100vw"
                        width="{{ image.width }}"
                        height="{{ image.height }}"
                        alt="{{ image_alt | escape }}"
                        loading="eager"
                        decoding="async"
                        {% if image.presentation.focal_point != blank %}
                          style="object-position: {{ image.presentation.focal_point }};"
                        {% endif %}
                      >
                    </picture>
                {% if link_url != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "GMK Promo Images",
  "settings": [
    {
      "type": "header",
      "content": "基础设置｜Base settings"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "启用 Section｜Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点 ID｜Anchor ID",
      "info": "小写英文、数字、连字符。Lowercase letters, numbers, and hyphens."
    },
    {
      "type": "header",
      "content": "布局设置｜Layout settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "区块宽度｜Section width",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "内容最大宽度｜Content max width",
      "min": 960,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1920
    },
    {
      "type": "range",
      "id": "edge_gutter",
      "label": "页面边距｜Edge gutter",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_edge_gutter",
      "label": "移动端页面边距｜Mobile edge gutter",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "图片间距｜Image gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "row_gap",

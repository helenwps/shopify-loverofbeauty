                      </div>
                    </div>
                  </popover-content>
                </div>
              {%- endif -%}

              {%- if locale_selector -%}
                <div class="popover-container">
                  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
                  <span class="visually-hidden">{{ 'header.general.language' | t }}</span>


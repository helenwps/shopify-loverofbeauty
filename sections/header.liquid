        {% render 'desktop-menu', menu: menu, bottom_navigation: true %}
      </nav>
    {%- endif -%}
    {%- endif -%}{%- comment -%} end of: if header_tabbed / else {%- endcomment -%}

    {%- if tab_panels_visible -%}
      <div class="header__tab-panels" data-header-tab-panels>
        <nav
          class="header__tab-panel header__bottom-navigation"
          id="header-panel-loverofbeauty-{{ section.id }}"
          role="tabpanel"
          aria-labelledby="header-tab-loverofbeauty-{{ section.id }}"
          data-header-tab-panel="loverofbeauty"
          aria-hidden="false"
        >
          {%- if lulus_menu_render.links.size > 0 -%}

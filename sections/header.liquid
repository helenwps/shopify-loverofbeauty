{%- if header_tabbed -%}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      var tabs = root.querySelectorAll('[data-header-tab]');
      var panels = root.querySelectorAll('[data-header-tab-panel]');
      if (!tabs.length || !panels.length) return;

      function closeSubmenusInPanel(panel) {
        if (!panel) return;
        panel.querySelectorAll('[aria-expanded="true"]').forEach(function (el) {
          el.setAttribute('aria-expanded', 'false');
        });
        panel.querySelectorAll('.mega-menu, .nav-dropdown').forEach(function (dd) {
          dd.setAttribute('hidden', '');
          dd.classList.remove('is-closing');
        });
      }

      function activate(id) {
        tabs.forEach(function (tab) {
          var on = tab.getAttribute('data-header-tab') === id;
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.tabIndex = on ? 0 : -1;
        });
        panels.forEach(function (panel) {
          var on = panel.getAttribute('data-header-tab-panel') === id;
          if (on) {
            panel.removeAttribute('hidden');
            panel.setAttribute('aria-hidden', 'false');
          } else {
            panel.setAttribute('hidden', '');
            panel.setAttribute('aria-hidden', 'true');
            closeSubmenusInPanel(panel);
          }
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activate(tab.getAttribute('data-header-tab'));
        });
        tab.addEventListener('keydown', function (e) {
          var keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
          if (keys.indexOf(e.key) === -1) return;
          e.preventDefault();
          var list = Array.prototype.slice.call(tabs);
          var i = list.indexOf(tab);
          var next = null;
          if (e.key === 'Home') next = list[0];
          else if (e.key === 'End') next = list[list.length - 1];
          else if (e.key === 'ArrowRight') next = list[(i + 1) % list.length];
          else if (e.key === 'ArrowLeft') next = list[(i - 1 + list.length) % list.length];
          if (next) {
            next.focus();
            activate(next.getAttribute('data-header-tab'));
          }
        });
      });

      var initial = Array.prototype.find.call(tabs, function (t) {
        return t.getAttribute('aria-selected') === 'true';
      });
      activate(initial ? initial.getAttribute('data-header-tab') : 'loverofbeauty');
    })();
  </script>

  {%- if section.settings.tab_disable_hover_submenu -%}
    <script>
      (function () {
        var root = document.getElementById('shopify-section-{{ section.id }}');
        if (!root) return;

        function rebindPanels() {
          var panels = root.querySelectorAll('[data-header-tab-panel]');
          panels.forEach(function (panel) {
            panel.querySelectorAll('desktop-navigation').forEach(function (nav) {
              if (nav.dataset.tabRebinded === '1') return;
              var clone = nav.cloneNode(true);
              clone.dataset.tabRebinded = '1';
              nav.parentNode.replaceChild(clone, nav);
              attachClickOnly(clone);
              attachHoverFlyouts(clone);
            });
          });
        }

        function getDropdownFor(triggerEl) {
          var id = triggerEl.getAttribute('aria-controls');
          if (!id) return null;
          return document.getElementById(id);
        }

        function closeAllInside(navEl, exceptParent) {
          navEl.querySelectorAll('[aria-expanded="true"]').forEach(function (el) {
            var li = el.closest('li');
            if (exceptParent && li === exceptParent) return;
            el.setAttribute('aria-expanded', 'false');
            var dd = getDropdownFor(el);
            if (dd) {
              dd.setAttribute('hidden', '');
              dd.classList.remove('is-closing');
            }
          });
        }

        function prefersHoverFlyoutPointer() {
          return window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        }

        function bindHoverFlyoutRow(li, triggerSelector) {
          if (li.dataset.hoverFlyoutBound === '1') return;
          li.dataset.hoverFlyoutBound = '1';
          var link = li.querySelector(triggerSelector);
          var dd = link ? document.getElementById(link.getAttribute('aria-controls')) : null;
          if (!link || !dd) return;
          var closeTimer;
          function openFlyout() {
            clearTimeout(closeTimer);
            dd.removeAttribute('hidden');
            link.setAttribute('aria-expanded', 'true');
          }
          function scheduleClose() {
            clearTimeout(closeTimer);
            closeTimer = setTimeout(function () {
              if (li.matches(':hover') || dd.matches(':hover')) return;
              dd.setAttribute('hidden', '');
              link.setAttribute('aria-expanded', 'false');
            }, 220);
          }
          li.addEventListener('mouseenter', openFlyout);
          li.addEventListener('mouseleave', scheduleClose);
          dd.addEventListener('mouseenter', function () {
            clearTimeout(closeTimer);
          });
          dd.addEventListener('mouseleave', scheduleClose);
          li.addEventListener('focusin', openFlyout);
          li.addEventListener('focusout', function (e) {
            if (!li.contains(e.relatedTarget)) scheduleClose();
          });
        }

        function attachHoverFlyouts(navEl) {
          if (!prefersHoverFlyoutPointer()) return;
          navEl.querySelectorAll('.header__linklist-item--tab-hover-flyout').forEach(function (li) {
            bindHoverFlyoutRow(li, '.header__linklist-link[aria-controls]');
          });
          navEl.querySelectorAll('.nav-dropdown__item--tab-hover-flyout').forEach(function (li) {
            bindHoverFlyoutRow(li, '.nav-dropdown__link[aria-controls]');
          });
        }

        function attachClickOnly(navEl) {
          navEl.addEventListener(
            'click',
            function (e) {
              var trigger = e.target.closest(
                '.header__linklist-link[aria-controls], .nav-dropdown__link[aria-controls]'
              );
              if (!trigger || !navEl.contains(trigger)) return;

              if (prefersHoverFlyoutPointer()) {
                if (
                  trigger.closest('.nav-dropdown__item--tab-hover-flyout') &&
                  trigger.matches('.nav-dropdown__link[aria-controls]')
                ) {
                  return;
                }
                if (
                  trigger.closest('.header__linklist-item--tab-hover-flyout') &&
                  trigger.matches('.header__linklist-link[aria-controls]')
                ) {
                  return;
                }
              }

              var dropdown = getDropdownFor(trigger);
              if (!dropdown) return;

              var isOpen = trigger.getAttribute('aria-expanded') === 'true';
              var li = trigger.closest('li');

              // \u70b9\u51fb\u540c\u7ea7\u65f6\u5148\u5173\u95ed\u5176\u5b83\u540c\u7ea7\u5df2\u5c55\u5f00\u7684\u9879
              if (li && li.parentElement) {
                li.parentElement.querySelectorAll(':scope > li').forEach(function (sib) {
                  if (sib === li) return;
                  sib.querySelectorAll('[aria-expanded="true"]').forEach(function (el) {
                    el.setAttribute('aria-expanded', 'false');
                    var dd = getDropdownFor(el);
                    if (dd) {
                      dd.setAttribute('hidden', '');
                      dd.classList.remove('is-closing');
                    }
                  });
                });
              }

              // a \u6807\u7b7e\u4e0d\u62e6\u622a\u9ed8\u8ba4\u8df3\u8f6c\uff1a\u4ec5\u5f53\u662f span\uff08\u7eaf\u89e6\u53d1\u5668\uff09\u6216\u5df2\u5c55\u5f00\u72b6\u6001\u624d\u62e6\u622a
              var isLinkAnchor = trigger.tagName === 'A' && trigger.getAttribute('href') && trigger.getAttribute('href') !== '#';
              if (isLinkAnchor && !isOpen) {
                // \u9996\u6b21\u70b9\u51fb\u201c\u6709\u94fe\u63a5\u7684\u4e00\u7ea7\u201d\uff0c\u5148\u5c55\u5f00 dropdown \u4e0d\u8df3\u8f6c
                e.preventDefault();
                trigger.setAttribute('aria-expanded', 'true');
                dropdown.removeAttribute('hidden');
                return;
              }

              // \u5176\u5b83\u60c5\u51b5\uff1a\u62e6\u622a\u5e76 toggle
              e.preventDefault();
              if (isOpen) {
                trigger.setAttribute('aria-expanded', 'false');
                dropdown.setAttribute('hidden', '');
              } else {
                trigger.setAttribute('aria-expanded', 'true');
                dropdown.removeAttribute('hidden');
              }
            },
            true
          );
        }

        function init() {
          rebindPanels();
        }

        if (window.customElements && window.customElements.whenDefined) {
          window.customElements.whenDefined('desktop-navigation').then(init).catch(init);
        } else {
          init();
        }

        // \u70b9\u51fb\u9762\u677f\u5916 / Esc \u5173\u95ed\u6240\u6709
        document.addEventListener('click', function (e) {
          var panels = root.querySelectorAll('[data-header-tab-panel]');
          panels.forEach(function (panel) {
            if (!panel.contains(e.target)) {
              panel.querySelectorAll('desktop-navigation').forEach(function (nav) {
                closeAllInside(nav, null);
              });
            }
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          var panels = root.querySelectorAll('[data-header-tab-panel]');
          panels.forEach(function (panel) {
            panel.querySelectorAll('desktop-navigation').forEach(function (nav) {
              closeAllInside(nav, null);
            });
          });
        });

        // \u8282\u70b9\u53d8\u52a8\u91cd\u7ed1
        var observer = new MutationObserver(function () {
          rebindPanels();
        });
        observer.observe(root, { childList: true, subtree: true });
      })();
    </script>
  {%- endif -%}
{%- endif -%}


          aria-hidden="true"
          hidden
        >
          {%- if outlet_menu_render.links.size > 0 -%}
            {%- render 'desktop-menu', menu: outlet_menu_render, bottom_navigation: true -%}
          {%- endif -%}
        </nav>
      </div>
    {%- endif -%}
  </div>
</store-header>


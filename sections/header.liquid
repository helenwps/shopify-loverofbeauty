{%- comment -%}
  IMPLEMENTATION NOTE: the header in Zalify is pretty complex as it allows a lot of different layouts. In order to make this code as efficient as possible and avoid as many reflows, we are using a lot of different CSS variables. If you need to touch this code, make sure to do it with EXTRA CARE as it may have some unwanted side effects.
{%- endcomment -%}

<style>
  :root {
    --enable-sticky-header: {% if section.settings.position == 'sticky' %}1{% else %}0{% endif %};
    --enable-transparent-header: {% if request.page_type == 'index' and section.settings.enable_transparent_header and section.settings.enable_tabbed_brand_nav == false %}1{% else %}0{% endif %};
    --loading-bar-background: {{ settings.header_text_color.red }}, {{ settings.header_text_color.green }}, {{ settings.header_text_color.blue }}; /* Prevent the loading bar to be invisible */
  }

  #shopify-section-{{ section.id }} {
    {%- if section.settings.cart_badge_background == 'rgba(0,0,0,0)' -%}
      {%- assign cart_badge_background = settings.header_text_color -%}
    {%- else -%}
      {%- assign cart_badge_background = section.settings.cart_badge_background -%}
    {%- endif -%}

    {%- if section.settings.cart_badge_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign cart_badge_text_color = settings.header_background -%}
    {%- else -%}
      {%- assign cart_badge_text_color = section.settings.cart_badge_text_color -%}
    {%- endif -%}

    {%- assign header_border_color = settings.header_background | color_mix: settings.header_text_color, 85 -%}

    --header-background: {{ settings.header_background.red }}, {{ settings.header_background.green }}, {{ settings.header_background.blue }};
    --header-text-color: {{ settings.header_text_color.red }}, {{ settings.header_text_color.green }}, {{ settings.header_text_color.blue }};
    --header-border-color: {{ header_border_color.red }}, {{ header_border_color.green }}, {{ header_border_color.blue }};
    --cart-badge-background: {{ cart_badge_background.red }}, {{ cart_badge_background.green }}, {{ cart_badge_background.blue }};
    --cart-badge-text-color: {{ cart_badge_text_color.red }}, {{ cart_badge_text_color.green }}, {{ cart_badge_text_color.blue }};
    --reduce-header-padding: {% if section.settings.reduce_desktop_padding %}1{% else %}0{% endif %};

    {%- if section.settings.logo != blank -%}
      --header-logo-width: {{ section.settings.mobile_logo_max_width }}px;
      --header-logo-height: {{ section.settings.mobile_logo_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
    {%- endif -%}

    position: {% if section.settings.position == 'sticky' %}sticky{% else %}relative{% endif %};
    z-index: 6;
  }

  {%- if section.settings.position == 'sticky' -%}
    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--enable-sticky-announcement-bar, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if request.page_type == 'index' and section.settings.enable_transparent_header -%}
    {%- unless section.settings.enable_tabbed_brand_nav -%}
    #shopify-section-{{ section.id }} {
      margin-bottom: calc(-1 * (var(--header-height, 0px) + var(--enable-sticky-announcement-bar, 0) * var(--announcement-bar-height, 0px)));
    }
    {%- endunless -%}

    .js #shopify-section-{{ section.id }} .header--transparent {
      {%- unless section.settings.transparent_header_cart_badge_background == 'rgba(0,0,0,0)' -%}
        {%- assign cart_badge_background = section.settings.transparent_header_cart_badge_background -%}
        --cart-badge-background: {{ cart_badge_background.red }}, {{ cart_badge_background.green }}, {{ cart_badge_background.blue }};
      {%- endunless -%}

      {%- unless section.settings.transparent_header_cart_badge_text_color == 'rgba(0,0,0,0)' -%}
        {%- assign cart_badge_text_color = section.settings.transparent_header_cart_badge_text_color -%}
        --cart-badge-text-color: {{ cart_badge_text_color.red }}, {{ cart_badge_text_color.green }}, {{ cart_badge_text_color.blue }};
      {%- endunless -%}

      --header-background: transparent;
      --header-text-color: {{ section.settings.transparent_header_text_color.red }}, {{ section.settings.transparent_header_text_color.green }}, {{ section.settings.transparent_header_text_color.blue }};
      --header-border-color: {{ section.settings.transparent_header_text_color.red }}, {{ section.settings.transparent_header_text_color.green }}, {{ section.settings.transparent_header_text_color.blue }}, 0.15;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .header__logo-image {
    max-width: {{ section.settings.mobile_logo_max_width }}px;
  }

  @media screen and (min-width: 741px) {
    {%- if section.settings.logo != blank -%}
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
        --header-logo-height: {{ section.settings.logo_max_width | divided_by: section.settings.logo.aspect_ratio | round }}px;
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} .header__logo-image {
      max-width: {{ section.settings.logo_max_width }}px;
    }
  }

  @media screen and (min-width: 910px) {
    {%- if section.settings.header_layout == 'logo_left_navigation_inline' -%}
      /* For this navigation we have to move the logo at the first and add a margin */
      [dir="rtl"] .header__logo {
        margin-left: 40px;
      }

      [dir="ltr"] .header__logo {
        margin-right: 40px;
      }

      .header__logo {
        order: -1;
      }

      @media screen and (min-width: 741px) {
        .header__secondary-links {
          max-width: max-content;
          margin-inline-start: 48px;
        }
      }
    {%- endif -%}

    {%- if section.settings.header_layout == 'logo_left_navigation_center' -%}
      /* For this navigation we have to move the logo and make sure the navigation takes the whole width */
      .header__logo {
        order: -1;
        flex: 1 1 0;
      }

      .header__inline-navigation {
        flex: 1 1 auto;
        justify-content: center;
        max-width: max-content;
        margin-inline: 48px;
      }
    {%- endif -%}
  }

  {%- if request.page_type == '404' -%}
    .shopify-section--404 {
      /* For the 404 page, we re-use the same colors as the header for design reason */
      --background: {{ settings.header_background.red }}, {{ settings.header_background.green }}, {{ settings.header_background.blue }};
      --heading-color: {{ settings.header_text_color.red }}, {{ settings.header_text_color.green }}, {{ settings.header_text_color.blue }};
      --text-color: {{ settings.header_text_color.red }}, {{ settings.header_text_color.green }}, {{ settings.header_text_color.blue }};
      --primary-button-background: {{ settings.header_text_color.red }}, {{ settings.header_text_color.green }}, {{ settings.header_text_color.blue }};
      --primary-button-text-color: {{ settings.header_background.red }}, {{ settings.header_background.green }}, {{ settings.header_background.blue }};
    }
  {%- endif -%}

  {%- if section.settings.enable_tabbed_brand_nav -%}
    /* ============ Tab \u5934\u90e8\u4e13\u7528\u6837\u5f0f\uff08\u4f5c\u7528\u57df\u9650 section\uff09============ */
    /*
      \u5168\u5bbd\u8d34\u8fb9\uff08\u89c6\u53e3\u5bbd\uff09\uff1a\u4ec5\u672c section\u3002
      \u8986\u76d6\u4e3b\u9898/\u81ea\u5b9a\u4e49 CSS \u91cc\u5e38\u89c1\u7684\u300c\u4e0e\u6b63\u6587\u540c\u5bbd\u300d\u5199\u6cd5\uff08max-width: var(--page-width\u2026) + margin-inline: auto + padding-inline\uff09\u3002
    */
    #shopify-section-{{ section.id }} .header--tabbed-full-bleed > .container,
    #shopify-section-{{ section.id }} store-header.header--tabbed-full-bleed > .container {
      box-sizing: border-box !important;
      width: 100% !important;
      max-width: none !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      margin-inline: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      padding-inline: 0 !important;
    }

    #shopify-section-{{ section.id }}.shopify-section--header {
      width: 100%;
      max-width: none;
    }

    /* \u4e00\u7ea7 + \u4e8c\u7ea7\u6761\u6a2a\u5411\u94fa\u6ee1\uff08\u7236\u7ea7 container \u5df2\u5168\u5bbd\uff0c\u65e0\u9700 100vw \u8d1f margin\uff0c\u907f\u514d\u6a2a\u5411\u6eda\u52a8\u6761\uff09 */
    #shopify-section-{{ section.id }} .header__tab-bar,
    #shopify-section-{{ section.id }} .header__tab-panels {
      width: 100%;
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      box-sizing: border-box;
    }

    /* Tab \u5934\u6574\u533a #F5F5F5 \u6a2a\u5411\u94fa\u6ee1\u89c6\u53e3\uff08\u6761\u672c\u8eab\u65e0\u4fa7\u5185\u8fb9\u8ddd\uff0c\u5185\u5bb9\u9760\u5de6\u53f3\u5757\u52a0 gutter\uff09 */
    #shopify-section-{{ section.id }} store-header.header--tabbed {
      background-color: #f5f5f5;
    }

    #shopify-section-{{ section.id }} .header__tab-bar {
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 60px;
      box-sizing: border-box;
      background-color: #f5f5f5;
      padding-block: 0;
      padding-inline: 0;
    }

    #shopify-section-{{ section.id }} .header--transparent .header__tab-bar {
      background-color: #f5f5f5;
    }

    #shopify-section-{{ section.id }} .header__tab-bar__left {
      display: flex;
      align-items: stretch;
      gap: 8px;
      flex: 0 1 auto;
      min-width: 0;
      height: 60px;
      /*padding-inline-start: var(--container-gutter);*/
	  padding-inline-start：0px;
    }

    #shopify-section-{{ section.id }} .header__tab-bar__hamburger {
      align-self: center;
    }

    #shopify-section-{{ section.id }} .header__brand-tabs {
      display: flex;
      align-items: stretch;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .header__brand-tab {
      appearance: none;
      border: 0;
      margin: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0 20px;
      font: inherit;
      color: rgb(var(--header-text-color));
      background-color: transparent;
      transition: background-color 0.2s ease;
      height: 60px;
      line-height: 60px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .header__brand-tab[aria-selected='true'] {
      background-color: #ffffff;
    }

    #shopify-section-{{ section.id }} .header__brand-tab__link {
      display: inline-flex;
      align-items: center;
      color: inherit;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .header__brand-tab__loverofbeauty-text {
      font-family: 'Brush Script MT', 'Segoe Script', 'Snell Roundhand', cursive;
      font-size: clamp(1.5rem, 3.5vw, 2.1rem);
      line-height: 1;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .header__brand-tab--outlet {
      font-family: ui-serif, Georgia, 'Times New Roman', serif;
      font-size: 0.8125rem;
      letter-spacing: 0.08em;
      font-weight: 700;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .header__brand-tab__outlet-icon {
      display: inline-flex;
      flex-direction: column;
      gap: 3px;
      width: 14px;
    }

    #shopify-section-{{ section.id }} .header__brand-tab__outlet-icon span {
      display: block;
      height: 2px;
      background: currentColor;
      border-radius: 1px;
    }

    #shopify-section-{{ section.id }} .header__tab-bar__right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex: 1 1 auto;
      min-width: 0;
      gap: 12px;
      height: 60px;
      padding-inline-end: var(--container-gutter);
    }

    #shopify-section-{{ section.id }} .header__tab-bar__search {
      flex: 0 1 280px;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .header__tab-bar__search .predictive-search__form {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .header__tab-bar__search .predictive-search__input {
      width: 100%;
      background: transparent;
      border: 0;
      border-bottom: 1px solid rgba(var(--header-border-color, var(--header-text-color)), 0.4);
      border-radius: 0;
      padding: 6px 28px 6px 0;
      box-shadow: none;
    }

    /* ============ \u4e8c\u7ea7\u9762\u677f ============ */
    #shopify-section-{{ section.id }} .header__tab-panels {
      background-color: #ffffff;
    }

    #shopify-section-{{ section.id }} .header__tab-panel {
      width: 100%;
      min-height: 50px;
      background-color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      box-sizing: border-box;
      padding-block: 4px;
      /* \u4e0e\u5916\u5c42 container \u5168\u5bbd\u4e00\u81f4\uff1a\u4e8c\u7ea7\u83dc\u5355\u6761\u4e0d\u518d\u56e0 gutter \u5185\u7f29 */
      padding-inline: 0;
    }

    #shopify-section-{{ section.id }} .header__tab-panel[hidden] {
      display: none !important;
    }

    /* \u8986\u76d6 Zalify \u9ed8\u8ba4 .header__bottom-navigation \u7684\u5c45\u4e2d */
    #shopify-section-{{ section.id }} .header__tab-panel.header__bottom-navigation .header__linklist,
    #shopify-section-{{ section.id }} .header__tab-panel desktop-navigation .header__linklist {
      justify-content: flex-start !important;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .header__tab-panel desktop-navigation {
      width: 100%;
      display: block;
    }

    /* \u88c1\u6389 mega-menu \u9ed1\u8272\u9075\u7f69\uff08\u907f\u514d\u906e\u4f4f\u9875\u9762\uff09 */
    #shopify-section-{{ section.id }} .header__tab-panel .mega-menu::after {
      display: none !important;
    }

    /* mega-menu / nav-dropdown \u5728 Tab \u9762\u677f\u91cc\u4ecd\u7136\u4ee5 absolute \u8df3\u51fa\uff0c\u8ba9\u5b83\u8d34\u5728\u9762\u677f\u4e0b\u8fb9 */
    #shopify-section-{{ section.id }} .header__tab-panel .mega-menu {
      left: 0;
      width: 100%;
    }

    /* mega \u5185\u5c42 .container \u4ecd\u5e26\u5168\u5c40 gutter\uff0c\u5728 Tab \u9762\u677f\u5185\u62c9\u6ee1\u5bbd */
    #shopify-section-{{ section.id }} .header__tab-panel .mega-menu > .container {
      padding-left: 0 !important;
      padding-right: 0 !important;
      padding-inline: 0 !important;
      max-width: none !important;
      width: 100%;
    }

    /* \u542f\u7528\u7ed9\u5916\u90e8\u63d2\u5165\u7684\u5b9a\u4f4d\u4f9d\u636e */
    #shopify-section-{{ section.id }} .header__tab-panel {
      position: relative;
    }

    /* \u4e8c\u7ea7\u4e2d\u300c\u4ec5\u60ac\u505c\u4e09\u7ea7\u300d\u9879\uff1a\u4e09\u7ea7\u9762\u677f\u76d6\u4f4f\u540c\u7ea7\u5176\u4ed6\u9879 */
    #shopify-section-{{ section.id }} .header__tab-panel .header__linklist-item--tab-hover-flyout {
      position: relative;
    }

    #shopify-section-{{ section.id }} .header__tab-panel .header__linklist-item--tab-hover-flyout:hover,
    #shopify-section-{{ section.id }} .header__tab-panel .header__linklist-item--tab-hover-flyout:focus-within,
    #shopify-section-{{ section.id }} .header__tab-panel .nav-dropdown__item--tab-hover-flyout:hover,
    #shopify-section-{{ section.id }} .header__tab-panel .nav-dropdown__item--tab-hover-flyout:focus-within {
      z-index: 5;
    }

    /* \u4e09\u7ea7\u9762\u677f\u4e0e\u4e8c\u7ea7\u94fe\u63a5\u533a\u5fae\u91cd\u53e0\uff0c\u907f\u514d\u79fb\u5165\u7a7a\u9699\u89e6\u53d1 mouseleave \u95ea\u70c1 */
    #shopify-section-{{ section.id }} .header__tab-panel .nav-dropdown__item--tab-hover-flyout > .nav-dropdown {
      margin-inline-start: -8px;
      padding-inline-start: 8px;
    }

    /* ============ \u54cd\u5e94\u5f0f ============ */
    @media screen and (max-width: 740px) {
      #shopify-section-{{ section.id }} .header__tab-bar__search {
        display: none;
      }
      #shopify-section-{{ section.id }} .header__tab-bar__right {
        gap: 8px;
      }
      #shopify-section-{{ section.id }} .header__tab-panel {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        flex-wrap: nowrap;
      }
      #shopify-section-{{ section.id }} .header__tab-panel desktop-navigation .header__linklist {
        flex-wrap: nowrap;
      }
      #shopify-section-{{ section.id }} .header__brand-tab {
        padding-inline: 14px;
      }
    }

    @media screen and (min-width: 741px) {
      #shopify-section-{{ section.id }} .header__tab-bar__search-icon {
        display: none;
      }
    }

    {%- if section.settings.tab_disable_hover_submenu -%}
      /* \u542f\u7528\u70b9\u51fb\u6a21\u5f0f\u540e\uff0cZalify \u9ed8\u8ba4 :hover \u5e95\u90e8\u9707\u52a8 / pseudo \u63a9\u9970\u5168\u90e8\u53d6\u6d88\uff0c\u907f\u514d\u8bef\u89e6\u53d1 */
      #shopify-section-{{ section.id }} .header__tab-panel .header__linklist-item.has-dropdown:hover::before {
        content: none !important;
      }

      /* theme.css \u4e2d .focus-outline :focus-within > .nav-dropdown \u4f1a\u8ba9\u5e26 [hidden] \u7684\u4e0b\u62c9\u4ecd\u53ef\u89c1\uff1b\u5f3a\u5236\u9690\u85cf\u76f4\u5230\u70b9\u51fb\u811a\u672c\u79fb\u9664 hidden */
      #shopify-section-{{ section.id }} .header__tab-panel .nav-dropdown[hidden],
      #shopify-section-{{ section.id }} .header__tab-panel .mega-menu[hidden] {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }

      #shopify-section-{{ section.id }} .header__tab-panel .mega-menu[hidden]::after {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
    {%- endif -%}

    /* \u518d\u538b\u4e00\u5c42\uff1astore-header \u4e0a\u5e26 .header \u65f6\u7279\u5f02\u6027\u7565\u9ad8\uff0c\u4fbf\u4e8e\u76d6\u540c\u6587\u4ef6\u5185\u5176\u5b83 .header--tabbed-full-bleed > .container \u89c4\u5219 */
    #shopify-section-{{ section.id }} store-header.header.header--tabbed-full-bleed > .container {
      max-width: none !important;
      width: 100% !important;
      margin-inline: 0 !important;
      padding-inline: 0 !important;
    }
  {%- endif -%}
</style>

{%- assign menu = section.settings.navigation_menu -%}
{%- assign header_tabbed = section.settings.enable_tabbed_brand_nav -%}
{%- liquid
  assign lulus_menu_render = menu
  if section.settings.tab_lulus_menu != blank and section.settings.tab_lulus_menu.links.size > 0
    assign lulus_menu_render = section.settings.tab_lulus_menu
  endif
  assign outlet_menu_render = menu
  if section.settings.tab_outlet_menu != blank and section.settings.tab_outlet_menu.links.size > 0
    assign outlet_menu_render = section.settings.tab_outlet_menu
  endif
  assign tab_panels_visible = false
  if header_tabbed
    if lulus_menu_render.links.size > 0 or outlet_menu_render.links.size > 0
      assign tab_panels_visible = true
    endif
  endif
-%}

<store-header
  class="header {% if settings.background == settings.header_background %}header--bordered{% endif %} {% if request.page_type == 'index' and section.settings.enable_transparent_header %}{% unless header_tabbed %}header--transparent{% endunless %}{% endif %}{% if header_tabbed %} header--tabbed header--tabbed-full-bleed{% if section.settings.tab_disable_hover_submenu %} header--tabbed-no-hover{% endif %}{% endif %}"
  role="banner"
  {% if section.settings.position == 'sticky' %}
    sticky
  {% endif %}
  {% if request.page_type == 'index' and section.settings.enable_transparent_header %}
    {% unless header_tabbed %}
      transparent
    {% endunless %}
  {% endif %}
>
  <div class="container">
    {%- if header_tabbed -%}
      {%- comment -%} ============ Tab \u5934\u90e8\uff1aloverofbeauty / OUTLET ============ {%- endcomment -%}
      <div class="header__wrapper header__tab-bar">
        <div class="header__tab-bar__left">
          {%- if menu.links.size > 0 -%}
            <button
              is="toggle-button"
              class="header__icon-wrapper tap-area hidden-editor-and-up header__tab-bar__hamburger"
              aria-controls="mobile-menu-drawer"
              aria-expanded="false"
            >
              <span class="visually-hidden">{{ 'header.general.navigation' | t }}</span>
              {%- render 'icon' with 'header-hamburger', width: 20, height: 20 -%}
            </button>
          {%- endif -%}

          <div class="header__brand-tabs" role="tablist" aria-label="Brand navigation">
            <button
              type="button"
              class="header__brand-tab header__brand-tab--loverofbeauty"
              role="tab"
              id="header-tab-loverofbeauty-{{ section.id }}"
              aria-selected="true"
              aria-controls="header-panel-loverofbeauty-{{ section.id }}"
              data-header-tab="loverofbeauty"
              tabindex="0"
            >
              <span class="header__brand-tab__loverofbeauty-text">loverofbeauty</span>
            </button>
            <button
              type="button"
              class="header__brand-tab header__brand-tab--outlet"
              role="tab"
              id="header-tab-outlet-{{ section.id }}"
              aria-selected="false"
              aria-controls="header-panel-outlet-{{ section.id }}"
              data-header-tab="outlet"
              tabindex="-1"
            >
              <span class="header__brand-tab__outlet-icon" aria-hidden="true">
                <span></span><span></span><span></span>
              </span>
              <span class="header__brand-tab__outlet-text">OUTLET</span>
            </button>
          </div>
